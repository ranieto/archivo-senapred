	"titulo": "Monitoreo Alerta Amarilla por incendio forestal para la Provincia de Melipilla",
	"fechaHora": "2023-12-11T11:27:53.5353-03:00",
	"createdAt": "2023-12-11T14:29:22.308Z",
	"updatedAt": "2023-12-14T16:25:37.257Z",
