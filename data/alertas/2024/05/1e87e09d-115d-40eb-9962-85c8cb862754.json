	"titulo": "Se modifica variable Alerta Temprana Preventiva para la Región del Maule por Evento Meteorológico",
	"fechaHora": "2024-05-18T12:39:11.1111-04:00",
	"createdAt": "2024-05-18T16:41:38.195Z",
	"updatedAt": "2024-05-21T16:20:28.353Z",
	"urlAccess": "se-declara-alerta-temprana-preventiva-para-la-region-del-maule-por-precipitaciones",
	"parentId": "920db1ab-c3aa-4836-b409-32b4dac1fa2a",
	"isPrincipal": false,
