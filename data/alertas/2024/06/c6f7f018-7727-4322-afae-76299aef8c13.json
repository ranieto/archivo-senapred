	"titulo": "Se actualiza Alerta Temprana Preventiva para las provincias de Magallanes y Tierra del Fuego por viento",
	"fechaHora": "2024-06-12T17:38:00.000-04:00",
	"createdAt": "2024-06-12T21:57:27.522Z",
