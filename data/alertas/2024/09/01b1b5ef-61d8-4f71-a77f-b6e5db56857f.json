	"titulo": "Se declara Alerta Temprana Preventiva para la Región de La Araucanía por evento meteorológico",
	"fechaHora": "2024-09-17T13:06:00.000-03:00",
	"createdAt": "2024-09-17T16:09:55.956Z",
	"updatedAt": "2024-09-23T18:51:49.156Z",
