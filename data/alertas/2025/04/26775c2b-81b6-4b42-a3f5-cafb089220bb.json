	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de Ñuble\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"color: black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC), se han </span><strong>cancelado</strong><span style=\"color: black\"> los siguientes alertamientos meteorológicos para la Región de Ñuble:</span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Fin</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A137-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Viento   normal a moderado en el litoral, cordillera de la costa, valle, precordillera   y cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">24-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">25-04</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A141-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   normales a moderada en corto periodo de tiempo en precordillera y cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">24-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">25-04</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a estos antecedentes, y en coordinación con la Delegación Presidencial Regional de Ñuble, la Dirección Regional del SENAPRED <strong>cancela la Alerta Temprana Preventiva regional por evento meteorológico, </strong>que se mantuvo vigente desde el 20 de abril de 2025.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
