	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de la Araucanía\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><br></p><p style=\"text-align:justify\"><strong><span style=\"color: black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC)</span></strong><span style=\"color:black\">, se encuentran vigentes los siguientes alertamientos meteorológicos para la Región de La Araucanía:</span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Fin</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Alerta AA27</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   moderadas a fuertes en corto período de tiempo en precordillera y cordillera   de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-04</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A129</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   normales a moderadas en corto periodo de tiempo en litoral, cordillera de la   costa y precordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">21-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">21-04</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A130-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   normales a moderadas en precordillera y cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-04</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso 134</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   normales a moderadas en corto periodo de tiempo en litoral y cordillera de la   costa.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-04</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso 135</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Probables   tormentas eléctricas en litoral, cordillera de la costa, valle y   precordillera de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-04</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"color:black\">Asimismo, conforme a lo indicado en el Informe de Amenaza Meteorológica de la DMC emitido el día de hoy, los montos de </span><span style=\"color:black\">precipitación (mm) y viento (km/h) pronosticados para la región son los siguientes.</span></p><div><table><tbody><tr><td rowspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Zona</span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Lunes 21</span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Martes 22</span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Miércoles 23</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Precipitaciones </span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Viento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Precipitaciones </span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Viento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Precipitaciones </span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">Viento</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Litoral   </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">15   – 30</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">25   – 40 con rachas de 50</span></p></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">20   – 40** </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">25   – 40 con rachas de 50</span></p></td><td rowspan=\"5\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Inferiores   a 1</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Cordillera   de la costa</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">20   – 35 </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Valle   longitudinal </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">15   – 30 </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">5   – 15 </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Precordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">50   – 70 </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">50   – 70* </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Cordillera   </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">40   – 65 </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">40   – 65* </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Entre   40 y 60 rachas de 70</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">–</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Isoterma   0°C (m.s.n.m.)</span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">2.900   – 3.300 &nbsp;</span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">3.300   – 3.500 </span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">3.500   – 3.000 </span></p></td></tr></tbody></table></div><p style=\"text-align:justify\"><span style=\"font-size:12px;color:black\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*Montos vigentes en Alerta AA27/2025&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; **Montos vigentes en Aviso A134/2025</span></p><p style=\"text-align:justify\"><span style=\"color:black\">Por su parte, </span><span style=\"color:black\">el Servicio Nacional de Geología y Minería (SERNAGEOMIN), </span><span style=\"color:black\">a través de su<strong> Actualización de la Minuta Técnica por Peligro de Remociones en Masa</strong>, indica que la posibilidad de ocurrencia de remociones en masa es<strong> alta </strong>en precordillera y cordillera<strong> moderada </strong>en litoral y cordillera de la costa, y <strong>baja</strong> en valle longitudinal de la región.</span></p><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a estos antecedentes, y en coordinación con la Delegación Presidencial Regional de La Araucanía, la Dirección Regional del SENAPRED <strong>modifica variable de la Alerta Temprana Preventiva regional a evento meteorológico, </strong>la que se mantienevigente desde el 18 de abril y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align:justify\"><span style=\"color:black\">La modificación de esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
	"variableRiesgoAlertasId": "07c971d4-5263-4093-a326-9a18e4399518"
}
