	"titulo": "Se Actualiza Alerta Temprana Preventiva para la Región de O’Higgins por Evento Meteorológico",
	"fechaHora": "2025-05-07T13:11:00.000-04:00",
	"createdAt": "2025-05-07T17:18:32.011Z",
	"updatedAt": "2025-05-09T14:58:13.872Z",
