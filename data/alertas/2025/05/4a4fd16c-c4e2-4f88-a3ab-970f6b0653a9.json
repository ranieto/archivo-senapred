	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de los Lagos\",\"nombreVariable\":\"Remoción en Masa\",\"nombreImg\":\"deslizamientos.png\"}",
	"contenido": "<p><strong><span style=\"color: black\">De acuerdo con la información proporcionada por el Servicio Nacional de Geología y Minería (SERNAGEOMIN)</span></strong><span style=\"color: black\">, se encuentra vigente el siguiente alertamiento para la Región de Los Lagos:</span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Zona</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Categoría</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Litoral </span></p></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">Alta</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera de la costa</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Precordillera </span></p></td><td rowspan=\"3\"><p style=\"text-align:center\"><span style=\"color:black\">Moderada</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Chiloé</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Litoral interior</span></p></td></tr></tbody></table><p style=\"margin-right:0cm;margin-left:18.0pt;text-align:justify\"><span style=\"color:black\">*El resto de la región presenta condición baja </span></p><p style=\"text-align:justify\"><span style=\"color:black\">Cabe mencionar, que de acuerdo con los antecedentes pronosticados por Dirección Meteorológica de Chile (DMC) mediante su informe de Riesgo Meteorológico los montos de precipitaciones (mm/cm) son los siguientes:</span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Zona</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">07 de mayo </span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">08 de mayo</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">09 de mayo</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Litoral </span></p></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">30 – 50</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10 – 20</span></p></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">1 – 5 </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera de la costa</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">15 – 30</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Valle longitudinal </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">5 – 15</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10 – 20</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">&lt; 5 </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Precordillera </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">20 – 40</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">20 – 45</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">3 – 10 </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">15 – 30 / 10 – 20 cm</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">5 – 10 / 10 – 20 cm</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">2 – 8 / <u>&lt;</u> 3 cm</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Chiloé</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10 -20</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10 – 20</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">3 – 10 </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Litoral interior</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40 – 60</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">15 – 30</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10 – 25 </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera austral </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">20 – 35 / 10 – 20 cm</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">5 – 10 / 10 – 25 cm</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">15 – 30 / &lt; 3 cm</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Patagonia subandina</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">15 – 30 / &lt; 3 cm</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">5 – 15</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1 – 5 </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Isoterma 0°C de Puerto Montt al norte</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1.300 – 1.000 – 1.900 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1.900 – 2.200 – 1.900</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1.900 – 2.500</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Isoterma 0°C de Puerto Montt al sur</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1.100</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1.100 – 1.700 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1.700 – 1.100 – 2.500</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a estos antecedentes, que suponen un aumento del riesgo asociado a dicha variable, y en coordinación con la Delegación Presidencial Regional de Los Lagos, la Dirección Regional del SENAPRED <strong>declara Alerta Temprana Preventiva regional por amenaza de remoción en masa, </strong>vigente a contar de hoy y hasta que las condiciones del evento así lo ameriten.</span></p><p style=\"text-align:justify\"><span style=\"color:black\">La declaración de esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 15px\"><strong><em><span style=\"color: black\">SENAPRED&nbsp;</span></em></strong></span><em><span style=\"color: black\">recomienda a la población prestar atención a señales que podrían indicar la ocurrencia de una remoción en masa, tales como: lluvia fuerte y sostenida por mayor tiempo de lo normal; subida o disminución repentina de nivel y caudal en cursos de agua; aumento en la turbiedad del agua en los cauces; y fuerte ruido de fondo.</span></em><span style=\"color: rgb(0, 0, 0);font-size: 15px\"><strong><em></em></strong></span><br></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
	"variableRiesgoAlertasId": "38db2540-6de4-4d12-b21d-28e250bcbbba"
}
