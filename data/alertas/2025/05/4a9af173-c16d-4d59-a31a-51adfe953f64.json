-10</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">-</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">Valle longitudinal</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">3-10</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">-</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">3-10</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">-</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">≤3</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">-</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">Precordillera</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">10-25/≤3cm</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">40-60 racha 80</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">15-30mm/≤3cm</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">-</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">3-10</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">-</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">Cordillera</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">5-15mm/10-25cm</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">-</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">10-25cm</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">-</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px\">1-5cm</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px