	"titulo": "Se actualiza Alerta Temprana Preventiva para la Región de La Araucanía por evento meteorológico",
	"fechaHora": "2025-05-16T17:41:46.4646-04:00",
	"createdAt": "2025-05-16T21:43:11.457Z",
	"updatedAt": "2025-05-18T17:49:05.830Z",
