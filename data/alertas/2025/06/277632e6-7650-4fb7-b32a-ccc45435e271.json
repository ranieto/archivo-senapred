	"titulo": "Se modifica variable de Alerta Temprana Preventiva para la Región de Antofagsta a evento meteorológico",
	"fechaHora": "2000-01-01T00:00:00.000-03:00",
	"createdAt": "2025-06-23T19:58:58.768Z",
	"updatedAt": "2025-06-23T20:00:28.468Z",
