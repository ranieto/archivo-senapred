	"titulo": "Se actualiza Alerta Temprana Preventiva para la Región de Los Lagos por heladas",
	"fechaHora": "2025-06-27T14:02:32.3232-04:00",
	"createdAt": "2025-06-27T18:03:28.832Z",
	"updatedAt": "2025-07-01T16:45:29.128Z",
	"urlAccess": "se-declara-alerta-temprana-preventiva-para-la-provincia-de-palena-por-nevadas",
	"parentId": "44ec1837-f10c-4862-b47c-af332572e427",
	"isPrincipal": false,
