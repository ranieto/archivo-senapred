	"titulo": "Se declara Alerta Temprana Preventiva para la Región de Los Ríos por nevadas",
	"fechaHora": "2025-08-02T18:03:00.000-04:00",
	"createdAt": "2025-08-02T22:20:29.872Z",
	"updatedAt": "2025-08-03T14:54:35.936Z",
	"urlAccess": "se-declara-alerta-temprana-preventiva-para-la-region-de-los-rios-por-nevadas",
	"parentId": "d0b0d1b7-9538-4b29-8f38-f54e24f099bf",
	"isPrincipal": false,
	"isActive": true,
	"isDeleted": false,
