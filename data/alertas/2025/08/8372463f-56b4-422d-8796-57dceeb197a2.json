	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región Metropolitana de Santiago\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><strong><span style=\"color: black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC)</span></strong><span style=\"color: black\">, se encuentran vigentes los siguientes alertamientos meteorológicos para la Región Metropolitana:</span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Fin</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Alerta AA78-1 </span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Heladas   moderadas a intensas con formación de hielo en valle y precordillera de la   región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">23-08</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">23-08</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A314</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Nevadas   normales a moderadas con probabilidad de ventiscas en cordillera de la   región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">21-08</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-08</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A315-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Probables   nevadas con probabilidad de riesgo en el desplazamiento en precordillera de   la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">21-08</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-08</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A317</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Viento   normal a moderado con probabilidad de viento blanco en cordillera de la   región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">21-08</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-08</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A318-3</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Probables   tormentas eléctricas con probabilidad de granizos en cordillera de la costa,   valle, precordillera y cordillera de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">21-08</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-08</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A321-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   normales a moderadas en cordillera de la costa y valle de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">21-08</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">22-08</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A322-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Heladas   normales a moderadas con formación de escarcha en cordillera de la costa,   valle y precordillera de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">23-08</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">24-08</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A327-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Viento   normal a moderado en cordillera de la costa y valle de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">21-08</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">21-08</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"color:black\">Además, de acuerdo con lo informado por la DMC en su Informe de Amenaza Meteorológica del día de hoy, los montos de precipitaciones (mm/cm), viento (km/h) e isoterma 0°C serán: </span></p><div><table><tbody><tr><td rowspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">Zona</span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">21 de agosto</span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">22 de agosto</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Precipitaciones </span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Viento </span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Precipitaciones </span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Viento </span></strong></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"color:black\">Cordillera   costa</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">30 – 35 </span></p></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">25 – 40 rachas de 50</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">5 – 10 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"color:black\">Valle </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">25 – 35 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10 – 20 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"color:black\">Precordillera   </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10 – 20</span></p><p style=\"text-align:center\"><span style=\"color:black\">20 – 30 cm </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">25 – 40 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10 – 15</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"color:black\">Cordillera   </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">60 – 80 cm </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40 – 60 rachas de 70 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10 – 15 cm </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">25 – 40 &nbsp;rachas de 70</span></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"color:black\">Isoterma   0°C</span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">2.200 – 900 </span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">1.200 – 900 </span></p></td></tr></tbody></table></div><p style=\"text-align:justify\"><span style=\"color:black\">Por otra parte, el Servicio Nacional de Geología y Minería (SERNAGEOMIN), mediante su Minuta Técnica por Peligro de Remociones en Masa, emitida el día de hoy, indica que la posibilidad de ocurrencia de remociones en masa tales como flujo de detritos, aluviones, deslizamientos y/o caídas de rocas (derrumbes) es <strong>moderada </strong>en cordillera de la costa y valle longitudinal y<strong> baja </strong>en el resto de la región.</span></p><p style=\"text-align:justify\"><span style=\"color:black\">Finalmente, de acuerdo con lo informado en los alertamientos vigentes las temperaturas fluctuarán entre los siguientes montos:</span></p><div><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Zona</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">21 de agosto</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">22 de agosto</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">23 de agosto</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera costa</span></p></td><td rowspan=\"4\"><p style=\"text-align:center\"><span style=\"color:black\">12°C</span></p></td><td rowspan=\"4\"><p style=\"text-align:center\"><span style=\"color:black\">1°C – 8°C</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-3°C y 0°C</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Valle</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-4°C y -6°C</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Precordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-8°C y -6°C</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr></tbody></table></div><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a estos antecedentes, y en coordinación con la Delegación Presidencial Regional Metropolitana, la Dirección Regional del SENAPRED <strong>Declara Alerta Amarilla y Cancela la Alerta Temprana Preventiva </strong></span><strong><span style=\"color:black\">Regional </span><span style=\"color:black\">por evento meteorológico</span></strong><span style=\"color:black\">,vigente a contar de hoy y hasta que las condiciones del evento así lo ameriten.</span></p><p style=\"text-align:justify\"><span style=\"color:black\">Con la declaración de la alerta amarilla, se alistarán escalonadamente los recursos necesarios para intervenir de acuerdo con la evolución del evento, con el objeto de evitar que éste crezca en extensión y severidad, minimizando los efectos negativos en las personas, sus bienes y el medio ambiente.</span></p>",
	"tipoAlertaId": "00c5c83a-4e44-4f7e-b589-bdb0b0ddde88",
	"variableRiesgoAlertasId": "866c7117-2784-49b5-aa31-5fbb11aaa1fd"
}
