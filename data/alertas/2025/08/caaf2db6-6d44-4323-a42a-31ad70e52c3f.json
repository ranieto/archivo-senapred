	"titulo": "Se modifica variable Alerta Temprana Preventiva para la región de Antofagasta por evento meteorológico",
	"fechaHora": "2025-08-16T16:10:47.4747-04:00",
	"createdAt": "2025-08-16T20:12:41.290Z",
	"updatedAt": "2025-08-25T17:26:39.472Z",
