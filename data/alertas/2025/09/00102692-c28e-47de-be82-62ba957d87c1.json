	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de la Araucanía\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><strong><span style=\"color: black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC</span></strong><span style=\"color: black\">), han sido cancelados los siguientes alertamientos meteorológicos para la Región de La Araucanía:</span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Fin</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Alerta AA83</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Viento   moderado a fuerte en el litoral.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">08-09</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">09-09</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A337-3</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Viento   normal a moderado en litoral, cordillera de la costa, valle y precordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">08-09</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10-09</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A338-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   normales a moderadas en litoral, cordillera de la costa, precordillera y   cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">09-09</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10-09</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso 347</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Probables   tormentas eléctricas con probabilidad de precipitaciones fuertes en un corto   periodo de tiempo, en el litoral, cordillera de la costa y valle.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">09-09</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10-09</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de La Araucanía, la Dirección Regional del SENAPRED <strong>cancela la Alerta Temprana Preventiva Regional por Evento Meteorológico, </strong>la cual se mantuvo vigente desde 05 de septiembre de 2025.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
