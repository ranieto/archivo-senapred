	"titulo": " Se modifica variable de Alerta Temprana Preventiva para la Región de Antofagasta a evento meteorológico",
	"fechaHora": "2025-09-06T13:45:00.000-04:00",
	"createdAt": "2025-09-06T17:49:03.139Z",
	"updatedAt": "2025-09-09T23:30:24.118Z",
	"urlAccess": "se-declara-alerta-temprana-preventiva-para-la-provincia-de-el-loa-y-comunas-de-antofagasta-taltal-mejillones-y-tocopilla-por-viento-2",
	"parentId": "6302cfdc-0b2e-4d3b-9a1b-63a574734d01",
