	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de la Araucanía\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><strong><span style=\"color: black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC)</span></strong><span style=\"color: black\">, se encuentra vigente el siguiente alertamiento meteorológico para la Región de La Araucanía:</span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Fin</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A364</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Probables   tormentas eléctricas con probabilidad de precipitaciones fuertes en corto   periodo de tiempo en zonas de litoral, cordillera de la costa y valle de la   región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">20-09</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">20-09</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"color:black\">Asimismo, según lo indicado en el Informe de Amenaza Meteorológica de la DMC, los montos de precipitaciones (mm/cm), viento (km/h) e isoterma cero (</span><span style=\"color:black\">m.s.n.m.)</span><span style=\"color:black\">, pronosticados para los próximos días en la región son los siguientes:</span></p><table><tbody><tr><td rowspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">Zona </span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">19 de septiembre</span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">20 de septiembre</span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">21 de septiembre</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Precipitaciones</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Viento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Precipitaciones</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Viento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Precipitaciones</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Viento</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Litoral</span></p></td><td rowspan=\"3\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">15   - 25 </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-</span></p></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">15   - 25</span></p></td><td rowspan=\"3\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">25   - 40 </span></p></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">2   - 4</span></p></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">25   - 40</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera de la costa</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Valle</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">5   - 15 </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">&lt;4</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Precordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">25   - 45 </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">15   - 25</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">5   - 15 </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">20   - 35 cm</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">10   - 20 cm</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">2   - 8 cm </span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">-   </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Isoterma °C</span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">1.800   – 2.000 </span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">2.000   – 1.600 </span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">1.600   – 1.200 </span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"color:black\">Por otro lado, </span><span style=\"color:black\">el Servicio Nacional de Geología y Minería (SERNAGEOMIN), </span><span style=\"color:black\">mediante su<strong> Minuta Técnica por Peligro de Remociones en Masa</strong>, indica que la posibilidad de ocurrencia de remociones en masa es <strong>moderada</strong> en litoral, cordillera de la costa, valle longitudinal y precordillera y <strong>baja</strong> en cordillera de la región.</span></p><p style=\"text-align:justify\"><span style=\"color:black\">Por su parte, el Centro Meteorológico Marítimo de Talcahuano a través de su Aviso Especial, indica el posible desarrollo de nubes convectivas, lo cual generaría condiciones propicias para la formación de trombas marinas, en sectores costeros de la Región de La Araucanía.</span></p><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a este antecedente y en coordinación con la Delegación Presidencial Regional de La Araucanía, la Dirección Regional del SENAPRED <strong>modifica variable de la Alerta Temprana Preventiva </strong></span><strong><span style=\"color:black\">Regional </span><span style=\"color:black\">a evento meteorológico</span></strong><span style=\"color:black\">,que se mantiene vigente desde hoy 19 de septiembre y hasta que las condiciones del evento así lo ameriten.</span></p><p style=\"text-align:justify\"><span style=\"color:black\">La modificación de esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
	"variableRiesgoAlertasId": "07c971d4-5263-4093-a326-9a18e4399518"
}
