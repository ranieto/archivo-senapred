	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región de Ñuble\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"color: rgb(0, 0, 0)\">De acuerdo con la información&nbsp;</span></strong><strong><span style=\"color: black\">técnica proporcionada por Conaf,</span></strong><span style=\"color: black\">respecto al incendio forestal en la comuna de Ninhue se informa el siguiente detalle:</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><a name=\"_Hlk157376193\"></a></span></p><table><tbody><tr><td><p><span style=\"color: rgb(0, 0, 0)\"><a name=\"_Hlk182357831\"><strong>Nombre del incendio</strong></a></span></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Hualte</span></p></td></tr><tr><td><p><span style=\"color: rgb(0, 0, 0)\"><strong>Estado</strong></span></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Controlado</span></p></td></tr><tr><td><p><span style=\"color: rgb(0, 0, 0)\"><strong>Superficie</strong></span></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">3.27 hectáreas</span></p></td></tr><tr><td><p><span style=\"color: rgb(0, 0, 0)\"><strong>Recursos</strong></span></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">3 brigadas, 2 técnicos y 2 aviones cisternas CONAF</span></p></td></tr></tbody></table><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En consideración de estos antecedente y en base a la información técnica proporcionada por CONAF, en coordinación con la Delegación Presidencial Regional de Ñuble, <strong>la Dirección Regional de SENAPRED cancela la Alerta Roja para la comuna de Ninhue por incendio forestal,</strong> que se encontraba vigente desde el 29 de diciembre de 2025.</span></p><p><br></p>",
