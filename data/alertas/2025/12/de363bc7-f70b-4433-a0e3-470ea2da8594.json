	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región de Coquimbo\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><span style=\"color: rgb(0, 0, 0)\"><strong>De acuerdo con la información&nbsp;técnica proporcionada por Conaf,&nbsp;</strong>respecto al incendio forestal en la&nbsp;<strong>comuna de Ovalle, </strong>se informa el siguiente detalle:</span></p><table><tbody><tr><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Nombre del incendio</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Aromos de Tabali 2</span></p></td></tr><tr><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Estado</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Extinguido</span></p></td></tr><tr><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Superficie</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">2.3 hectáreas</span></p></td></tr><tr><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Recursos</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Cuerpo de bomberos de Ovalle</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">2 brigadas y 1 técnico Conaf </span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">1 camión cisterna.</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en coordinación con la delegación Presidencial Regional de Coquimbo, la Dirección Regional de <strong>SENAPRED&nbsp;cancela la Alerta Amarilla para la comuna de Ovalle por incendio forestal,</strong> que se mantuvo vigente desde el 19 de diciembre de 2025.</span></p>",
	"tipoAlertaId": "00c5c83a-4e44-4f7e-b589-bdb0b0ddde88",
