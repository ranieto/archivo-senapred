	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región del Maule\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><span style=\"color: rgb(0, 0, 0)\"><strong>De acuerdo con la información&nbsp;técnica proporcionada por Conaf y el SINAPRED,&nbsp;</strong>respecto a los incendios forestales en la&nbsp;<strong>comuna de Talca,&nbsp;</strong>se informa el siguiente detalle:</span></p><table><tbody><tr><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Nombre del incendio</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><span style=\"color: rgb(0, 0, 0)\">Los Hoteleros</span></span></p></td></tr><tr><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Estado</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"color:#000000\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Controlado</span></span></p></td></tr><tr><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Superficie</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">1 hectárea</span></p></td></tr><tr><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Recursos</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cuerpo de Bomberos de Talca</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">2 brigadas, 1 técnico, 2 helicópteros y 1 camión cisterna CONAF</span></p></td></tr></tbody></table><table><tbody><tr><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Nombre del incendio</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Circunvalación Norte</span></p></td></tr><tr><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Estado</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Controlado</span></p></td></tr><tr><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Superficie</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">10 hectáreas</span></p></td></tr><tr><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Recursos</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cuerpo de Bomberos de Talca, Maule, Pelarco, San Clemente y San Rafael</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">2 brigadas, 4 aviones cisterna, 2 helicópteros, 1 skidder y 1 aljibe CONAF</span></span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">1 Aljibe CGE</span></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">SENAPRED Maule ( Director Regional y Jefe de Operaciones)</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Delegado Presidencial Regional del Maule</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Comandante Regimiento N°16 Talca</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">2 Aljibes gestionados por SISS</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">17 Seguridad Municipal Talca</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">3 funcioanrios Área Social Municipalidad de Talca</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">3 funcionarios Depto Operativo Municipalidad de Talca</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">60 Carabineros</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">12 Vehiculos Carabineros, incluido carro lanza agua<br></span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 14px\"><span style=\"color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en&nbsp;coordinación con la delegación Presidencial Regional de Maule, la Dirección Regional de SENAPRED </span><strong><span style=\"color: rgb(0, 0, 0)\">cancela&nbsp;la Alerta Roja para la Comuna de Talca por incendio forestal</span></strong><span style=\"color: rgb(0, 0, 0)\">, que se mantuvo vigente desde el 14 de enero&nbsp;</span></span><span style=\"color: rgb(0, 0, 0);font-size: 14px\">de 2026.</span></p>",
