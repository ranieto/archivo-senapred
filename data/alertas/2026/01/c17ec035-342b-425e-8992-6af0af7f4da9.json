	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región de Ñuble\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><span style=\"font-size: 14px\"><span style=\"color: rgb(0, 0, 0)\"><strong>De acuerdo con la información&nbsp;técnica proporcionada por Conaf,&nbsp;</strong>respecto al incendio forestal en la&nbsp;<strong>comuna de Pinto&nbsp;</strong>se informa el siguiente detalle:</span></span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><table><tbody><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Nombre del incendio</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">El Cardal</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Estado</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En combate</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Superficie</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">30 hectáreas</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Recursos</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cuerpo de Bomberos de Pinto</span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">4 brigadas, 2 técnicos, 2 aviones cisterna y 1 Unidad de   Análisis de Diágnostico CONAF</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Observaciones</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Incendio de pastizal, matorral y bosque que presenta   cercanía a sectores habitados.</span></p></td></tr></tbody></table><table><tbody><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Nombre del incendio</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Reserva Ñuble</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Estado</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En combate</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Superficie</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">36.2 hectáreas</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Recursos</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">4 brigadas, 3 técnicos, 4 aeronaves, 2 camiones de   combustible y 1 puesto de mando CONAF</span></p></td></tr><tr><td><div><span style=\"color: rgb(0, 0, 0)\"><strong>Observaciones</strong></span></div></td><td><div><span style=\"color: rgb(0, 0, 0)\">Incendio al interior de Área Silvestre Protegida de la Reserva Nacional Ñuble.<br></span></div></td></tr></tbody></table><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En consideración a este antecedente y en base a la información técnica proporcionada por CONAF, en&nbsp;coordinación con la Delegación Presidencial Regional de Ñuble, la Dirección Regional de SENAPRED<strong>&nbsp;mantiene la Alerta Roja para la Comuna de Pinto por incendio forestal</strong>, que se encuentra vigente desde el&nbsp;13 de enero de 2026.</span></p>",
