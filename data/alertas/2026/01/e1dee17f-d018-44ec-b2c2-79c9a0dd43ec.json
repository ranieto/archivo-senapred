	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región del Libertador Gral. Bernardo O'Higgins\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p style=\"text-align:justify\"><strong><span style=\"color:black\">De acuerdo con la información técnica proporcionada por Conaf,&nbsp;</span></strong><span style=\"color:black\">respecto a los incendios forestales en la comuna de San Fernando; se informa el siguiente detalle:</span></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><table><tbody><tr><td><p style=\"text-align:justify\"><strong><span style=\"color:black\">Nombre del   incendio</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Fundo La Palma</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"color:black\">Estado</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Extinguido</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"color:black\">Superficie</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">10 (ha)</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"color:black\">Observaciones</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">No se reportan   afectaciones en personas ni daños en viviendas en la comuna de San Fernando.</span></p></td></tr></tbody></table><p style=\"text-align:justify\"></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, la Dirección Regional de SENAPRED cancela la Alerta Roja para la Comuna de San Fernando, por incendio forestal, que se mantuvo vigente desde el 18 de enero de 2026.</span></p>",
