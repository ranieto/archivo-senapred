	"titulo": "Se declara Alerta Amarilla para la Región de Atacama por calor intenso",
	"fechaHora": "2026-02-05T15:01:00.000-03:00",
	"createdAt": "2026-02-05T18:03:39.450Z",
	"updatedAt": "2026-02-08T01:36:37.957Z",
