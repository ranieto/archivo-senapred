	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región del Biobío\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">De acuerdo con la información&nbsp;</span></strong><strong><span style=\"color: black\">técnica proporcionada por Conaf&nbsp;</span></strong><span style=\"color: black\">respecto al incendio forestal en la comuna de&nbsp;<strong>Los Ángeles,&nbsp;</strong>se informa el siguiente detalle:</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><table><tbody><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><a name=\"_Hlk182357831\"><strong>Nombre del incendio</strong></a></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Los Guanacos III</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Estado</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Controlado</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Superficie</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">15 hectáreas</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Recursos</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">6 compañías del Cuerpo de Bomberos de Los Ángeles</span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">9 brigadas terrestres, 1 técnicos y 8 aeronaves de CONAF</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Observaciones</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Incendio forestal no registró afectación a viviendas e infraestructura crítica.</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en coordinación con la Delegación Presidencial Regional de Biobío, la Dirección Regional de SENAPRED <strong>cancela la Alerta Roja para la comuna de Los Ángeles por incendio forestal</strong>, que se mantuvo vigente desde el 24 de febrero de 2026.</span></p>",
	"tipoAlertaId": "78e12f4b-a976-4f7c-a8cc-cd9aa3838bcd",
