	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región de Valparaíso\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">De acuerdo a la información proporcionada por CONAF,&nbsp;</span></strong><span style=\"font-size: 15px\">en atención al incendio forestal en las comunas de Concón y Limache, se reporta el siguiente detalle:</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\"><br></span></p><table><tbody><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Comuna</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Limache</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Nombre del incendio</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Forestal Ace</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Estado</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">En combate</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Superficie</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">250 hectáreas</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Recursos</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Cuerpo de Bomberos de Limache, Viña del Mar, Villa Alemana, Quilpué, Concón, Quillota y Olmué</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">9 brigadas herramientas y 4 brigadas de agua</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">12 técnicos, 2 skidder, 3 aviones, 4 helicópteros y 1 tranqueros CONAF</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">2 helicópteros SENAPRED</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">1 Brifar Armada</span></p></td></tr></tbody></table><div style=\"text-align: justify\"><table><tbody><tr><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\"><strong>Comuna</strong></span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Concón</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Nombre del incendio</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Forestal ACE 2</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Estado</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Bajo observación</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Superficie</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">0.01 (ha)</span></p></td></tr></tbody></table></div><div style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\"><br></span></div><div style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">En consideración a este antecedente y en base a la información técnica proporcionada por CONAF, en coordinación con la Delegación Presidencial Regional de Valparaíso, la Dirección Regional de SENAPRED mantiene la Alerta Roja para las comunas de Concón y Limache por incendio forestal, que se encuentra vigente desde el 13 de febrero de 2026.</span></div><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\"><br></span></p><div style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">​</span></div>",
