	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región del Maule\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">De acuerdo con la información&nbsp;técnica proporcionada por Conaf&nbsp;</span></strong>respecto al incendio forestal en la comuna de Teno, se informa el siguiente detalle:</p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><table><tbody><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><a name=\"_Hlk182357831\">Nombre del incendio</a></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cuesta El Peral</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Estado</span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En combate</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Superficie</span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">70 hectáreas</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Recursos</span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">1 brigada nocturna CONAF</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Observaciones</span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Término o disminución de las condiciones que dieron origen a la declaración de la Alerta Roja,.</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en coordinación con la delegación Presidencial Regional de Maule, la Dirección Regional de SENAPRED <strong>cancela la Alerta Roja para la comuna de Teno por incendio forestal,</strong> que se mantuvo vigente desde el 17 de febrero de 2026.</span></p>",
	"tipoAlertaId": "78e12f4b-a976-4f7c-a8cc-cd9aa3838bcd",
