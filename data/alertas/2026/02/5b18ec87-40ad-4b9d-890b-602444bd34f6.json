	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región de Valparaíso\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">De acuerdo con la información&nbsp;</span></strong><span style=\"font-size: 14px\"><strong><span style=\"color: black\">técnica proporcionada por Conaf&nbsp;</span></strong><span style=\"color: black\">respecto al incendio forestal en la comuna de San Antonio, se informa el siguiente detalle:</span></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><span style=\"color: black\"><br></span></span></p><table><tbody><tr><td><p><a name=\"_Hlk182357831\"><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Nombre del incendio</span></strong></a></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Rinconada de San Juan 2</span></span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Estado</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En combate</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Superficie</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">4 hectáreas</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Recursos</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cuerpo de Bomberos de San Antonio, El Quisco y San Antonio</span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">4 brigadas, 2 técnicos y 5 aviones cisterna CONAF</span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Equipo GRD Ilustre Municipalidad de San Antonio</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">En consideración a este antecedente y en base a la información técnica proporcionada por CONAF, en coordinación con la Delegación Presidencial Regional de Valparaíso, la Dirección Regional de SENAPRED <strong>mantiene la Alerta Amarilla para la comuna de San Antonio por incendio forestal</strong>, que se encuentra vigente desde el 25 de febrero de 2026.</span></p>",
