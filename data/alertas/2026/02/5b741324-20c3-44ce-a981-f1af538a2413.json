	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región de los Lagos\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p style=\"text-align:justify\"><strong><span style=\"font-size:15px\">De acuerdo a la información proporcionada por CONAF, </span></strong><span style=\"font-size:15px\">en atención al incendio forestal en la comuna de Castro, se reporta lo siguiente:</span></p><p style=\"text-align: justify\"><span style=\"font-size:15px\"><br></span></p><table><tbody><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size:15px\">Nombre   del incendio</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">Mirador   San José</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size:15px\">Estado</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">En   combate</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size:15px\">Superficie</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">4   (ha)</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size:15px\">Afectación</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">El incendio   forestal presenta una disminución de las condiciones que dieron origen al   alertamiento.</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><br></p><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en coordinación con la delegación Presidencial Regional de Los Lagos, la Dirección Regional de SENAPRED <strong>cancela la Alerta Amarilla</strong> para la Comuna de Castro, por incendio forestal, que se mantuvo vigente desde el 13 de febrero de 2026.</span></p>",
	"tipoAlertaId": "00c5c83a-4e44-4f7e-b589-bdb0b0ddde88",
