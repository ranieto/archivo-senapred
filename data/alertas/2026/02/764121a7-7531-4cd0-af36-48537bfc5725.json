	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región del Maule\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">De acuerdo con la información&nbsp;técnica proporcionada por Conaf </span></strong>respecto al incendio forestal en la comuna de Teno, se informa el siguiente detalle:</p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><table><tbody><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><a name=\"_Hlk182357831\">Nombre del incendio</a></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cuesta El Peral</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Estado</span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En combate</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Superficie</span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">70 hectáreas</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Recursos</span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">2 brigadas y 1 camión aljibe CONAF</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Observaciones</span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">A raíz de este incendio se activó  Mensajeria SAE para reforzar el proceso de evacuación en el sector Cuesta El Peral a las 18:44 hrs de hoy.</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">En consideración a este antecedente y en base a la información técnica proporcionada por CONAF, en coordinación con la Delegación Presidencial Regional de Maule, la Dirección Regional de SENAPRED<strong> mantiene la Alerta Roja para la comuna de Teno por incendio forestal</strong>, que se encuentra vigente desde el 17 de febrero de 2026.</span></p>",
	"tipoAlertaId": "78e12f4b-a976-4f7c-a8cc-cd9aa3838bcd",
