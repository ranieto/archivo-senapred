	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región de Valparaíso\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">De acuerdo a la información proporcionada por CONAF,&nbsp;</span></strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">en atención al incendio forestal en las comunas de Concón y Limache, se reporta el siguiente detalle:</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\"><br></span></p><table><tbody><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Nombre del incendio</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Forestal Ace</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Estado</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">En combate</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Superficie</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">280 hectáreas</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Recursos</span></strong></p></td><td><p style=\"text-align: justify\">Cuerpo de Bomberos de Limache, Viña del Mar, Villa Alemana, Quilpué, Concón, Quillota y Olmué</p>13 Brigadas; 14 técnicos y 9 aeronaves CONAF<br><br>2 helicópteros SENAPRED<br><br>1 Brigada forestal de la Armada<br><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">​<br></span></p></td></tr></tbody></table><div style=\"text-align: justify\"><table><tbody><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Nombre del incendio</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Forestal ACE 2</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Estado</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Bajo observación</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Superficie</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">0.01 (ha)</span></p></td></tr></tbody></table></div><div style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\"><br></span></div><div style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">En&nbsp;consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en&nbsp;coordinación con la Delegación Presidencial Regional de Valparaíso, la Dirección Regional de SENAPRED&nbsp;<strong>cancela la Alerta Roja y declara Alerta Amarilla para las comunas de Concón y Limache por incendio&nbsp;forestal</strong>, vigente desde hoy y hasta que las condiciones del incendio así lo ameriten.</span></div><div style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Con la declaración de esta Alerta Amarilla, se mantendrán alistados escalonadamente los recursos&nbsp;</span><span style=\"color: rgb(0, 0, 0);font-size: 14px\">necesarios, en apoyo adicional a lo ya desplegado por CONAF, Bomberos y el Sistema Nacional de&nbsp;</span><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Prevención y Respuesta ante Desastres, con el objeto de evitar que el evento crezca en extensión y&nbsp;</span><span style=\"color: rgb(0, 0, 0);font-size: 14px\">severidad, minimizando los efectos negativos en las personas, sus bienes y el medio ambiente.</span></div>",
	"tipoAlertaId": "00c5c83a-4e44-4f7e-b589-bdb0b0ddde88",
