	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región de Valparaíso\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">De acuerdo a la información proporcionada por CONAF </span></strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">respecto al</span><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">&nbsp;incendio forestal en las comunas de Concón y Limache, se reporta el siguiente detalle:</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><table><tbody><tr><td><p style=\"text-align: justify\"><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Nombre del incendio</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Forestal Ace</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Estado</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En combate</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Superficie</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">300 hectáreas</span></p></td></tr><tr><td><p style=\"text-align: justify\"><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Recursos</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Cuerpo de Bomberos de Limache, Viña del Mar, Villa Alemana, Quilpué, Concón, Quillota y Olmué</span></p><span style=\"color: rgb(0, 0, 0)\">3 Brigadas y 1 técnico CONAF</span></td></tr></tbody></table><div style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></div><div style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en coordinación con la delegación Presidencial Regional de Valparaíso, la Dirección Regional de SENAPRED <strong>cancela Alerta Amarilla para las comunas de Concón y Limache por incendio forestal,</strong> que se mantuvo vigente desde el 16 de febrero de 2026.</span></div>",
	"tipoAlertaId": "00c5c83a-4e44-4f7e-b589-bdb0b0ddde88",
