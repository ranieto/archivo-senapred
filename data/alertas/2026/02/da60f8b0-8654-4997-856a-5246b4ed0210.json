	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región de la Araucanía\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">De acuerdo con la información&nbsp;</span></strong><span style=\"font-size: 16px\"><strong><span style=\"color: black\">técnica proporcionada por Conaf&nbsp;</span></strong><span style=\"color: black\">respecto al incendio forestal en la comuna de Perquenco, se informa el siguiente detalle:</span></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><span style=\"color: black\"><br></span></span></p><table><tbody><tr><td><p><a name=\"_Hlk182357831\"><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Nombre del incendio</span></strong></a></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Guacolda 2</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Estado</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En combate</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Superficie</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">100 hectáreas</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Recursos</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cuerpo de Bomberos de Perquenco y Victoria</span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">4 brigadas, 2 técnicos, 6 aeronaves, 1 maquinaria pesada y 1 camión cisterna CONAF</span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En trayecto: 1 maquinaria pesada, 1 camión cisterna y 2 brigadas CONAF.&nbsp; Personal municipal y Carabineros.</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Observaciones</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Incendio se desarrolla cercano a sectores poblados</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En consideración&nbsp;a este antecedente y en base a la información técnica proporcionada por CONAF, en&nbsp;coordinación con la Delegación Presidencial Regional de La Araucanía, la Dirección Regional de SENAPRED&nbsp;<strong>mantiene la Alerta Roja para la comuna de Perquenco por incendio forestal</strong>, que se encuentra vigente&nbsp;desde el 25 de febrero de 2026.</span></p>",
