	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región de Ñuble\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">De acuerdo con la información&nbsp;</span></strong><strong><span style=\"color: black\">técnica proporcionada por Conaf,&nbsp;</span></strong><span style=\"color: black\">respecto al incendio forestal en la comuna de&nbsp;<strong>Chillán,&nbsp;</strong>se informa el siguiente detalle:</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><a name=\"_Hlk157376193\"></a></span></p><table><tbody><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><a name=\"_Hlk182357831\"><strong>Nombre del incendio</strong></a></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Santa Laura</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Estado</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En combate</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Superficie</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">5 hectáreas</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Recursos</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cuerpo de Bomberos de Chillán, Coihueco y San Nicolás</span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">6 brigadas, 3 técnicos, 2 aviones cisterna y 1 helicóptero CONAF</span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">1 móvil de combustible, 1 puesto de mando y 1 unidad de investigación de incendios UAD</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Observaciones</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">No se reportan afectaciones en personas ni daños en viviendas a raíz de este incendio.</span></p></td></tr></tbody></table><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en coordinación con la delegación Presidencial Regional de Ñuble, la Dirección Regional de SENAPRED <strong>cancela la Alerta Roja para la comuna de Chillán por incendio forestal</strong>, que se mantuvo vigente desde el 09 de febrero de 2026.</span></p><div><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></div><p><span style=\"color: rgb(0, 0, 0);font-size: 14px\">​</span></p>",
	"tipoAlertaId": "78e12f4b-a976-4f7c-a8cc-cd9aa3838bcd",
