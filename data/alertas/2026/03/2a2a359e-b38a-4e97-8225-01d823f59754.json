	"titulo": "Monitoreo Alerta Temprana Preventiva para la Región de O'Higgins por evento meteorológico",
	"fechaHora": "2026-03-14T20:42:49.4949-03:00",
	"createdAt": "2026-03-14T23:44:50.395Z",
	"updatedAt": "2026-03-17T17:05:45.087Z",
