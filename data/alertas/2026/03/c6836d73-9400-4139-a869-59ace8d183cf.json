	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"r\",\"comunas\":\"\",\"regiones\":\"Región de la Araucanía\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">De acuerdo con la información&nbsp;</span></strong><span style=\"font-size: 16px\"><strong><span style=\"color: black\">técnica proporcionada por Conaf&nbsp;</span></strong><span style=\"color: black\">respecto al incendio forestal en la comuna de Galvarino, se informa el siguiente detalle:</span></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><span style=\"color: black\"><br></span></span></p><table><tbody><tr><td><p><a name=\"_Hlk182357831\"><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Nombre del incendio</span></strong></a></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Huilcán Llamin</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Estado</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En combate</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Superficie</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">29.3 hectáreas</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Recursos</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cuerpo de Bomberos de Galvarino, Nueva Imperial y Lautaro</span></p><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">5 brigadas, 4 técnicos, 1 maquinaria pesada, puesto de mando y 1 camión cisterna CONAF</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Observaciones</span></strong></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><span style=\"font-size: 16px\">El incendio forestal ya no presenta amenaza a viviendas, encontrándose contenido en el sector izquierdo y con mayor actividad en el sector derecho.</span><br></span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en coordinación con la Delegación Presidencial Regional de La Araucanía, la Dirección Regional de SENAPRED <strong>cancela la Alerta Roja para la comuna de Galvarino por incendio forestal</strong>, que se mantuvo vigente desde el 05 de marzo de 2026.</span></p><p style=\"text-align: justify\"></p>",
	"tipoAlertaId": "78e12f4b-a976-4f7c-a8cc-cd9aa3838bcd",
