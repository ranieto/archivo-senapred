	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de los Lagos\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"color: black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC), se encuentran vigentes los siguientes alertamientos meteorológicos para la Región de Los Lagos:&nbsp;&nbsp;</span></p><p><span style=\"color: black\"><br></span></p><p><span style=\"color: black\"><br></span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Fin</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Alerta AA68</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   moderadas a fuertes en corto periodo de tiempo, en cordillera de la costa,   precordillera, cordillera, litoral interior y cordillera austral.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">28-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">28-04</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A202-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Viento   normal a moderado en litoral, cordillera de la costa, cordillera, Chiloé y   litoral interior.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">28-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">28-04</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A203-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   normales a moderadas en corto periodo de tiempo en litoral, Chiloé y   patagonia subandina.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">28-04</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">28-04</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"color:black\">Asimismo, conforme a lo indicado en el Informe de Amenaza Meteorológica, los montos estimados de precipitaciones (mm), viento (km/h) e isoterma cero (m.s.n.m) para el martes 28 y miércoles 29 de abril son los siguientes:</span></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><div><table><tbody><tr><td rowspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">Sector</span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">Martes 28</span></strong></p></td><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">Miércoles   29</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Precipitaciones</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Viento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Precipitaciones</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Viento</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Litoral</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">20-40</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40-60 rachas 70</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">≤3</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera de la costa</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">30-60</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40-60 rachas 70</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">2-8</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Valle longitudinal</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10-25</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">25-40 rachas 50</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Precordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">30-60</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">25-40 rachas 60</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">≤5</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">30-60</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40-60 rachas 80</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">≤5</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Chiloé</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">20-45</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40-60 rachas 70</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">≤5</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Litoral interior</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">30-60</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40-60 rachas 80</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">≤10</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera Austral</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40-70mm/≤3cm</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">20-45mm/≤8cm</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Patagonia subandina</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">25-45</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40-60</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">2-8</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Isoterma cero</span></p><p style=\"text-align:center\"><span style=\"color:black\">Al norte de   Puerto Montt</span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">3.100 – 1.500 </span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">1.500-2.700-2.200</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Isoterma cero</span></p><p style=\"text-align:center\"><span style=\"color:black\">Al sur de   Puerto Montt</span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">1.800 – 2.200   – 1.400 </span></p></td><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">1.400</span></p></td></tr></tbody></table></div><p style=\"text-align:justify\"><br></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"color:black\">Por otra parte, el Servicio Nacional de Geología y Minería (SERNAGEOMIN), mediante su <strong>Minuta Técnica por peligro de remoción en masa</strong>, indica que la posibilidad de ocurrencia de aluviones (flujos de detritos) y derrumbes (deslizamientos, caídas de rocas) es <strong>alta</strong> en Cordillera Austral y <strong>moderada </strong>en el resto de la región.</span></p><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Los Lagos, la Dirección Regional del SENAPRED mantiene la<strong> Alerta Temprana Preventiva Regional por evento meteorológico</strong>, vigente desde el 26 de abril y hasta que las condiciones meteorológicas así lo ameriten.</span></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"color:black\">Esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
	"variableRiesgoAlertasId": "07c971d4-5263-4093-a326-9a18e4399518"
}
