	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de la Araucanía\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"font-size: 14px\"><span style=\"color: black\">De acuerdo con la </span><strong><span style=\"color: black\">información proporcionada por la Dirección Meteorológica de Chile (DMC)</span></strong><span style=\"color: black\">, se encuentra vigente el siguiente alertamiento meteorológico para la Región de La Araucanía:</span></span></p><p><span style=\"font-size: 14px\"><br></span></p><table><tbody><tr><td><p style=\"text-align: center\"><span style=\"font-size: 14px\"><strong><span style=\"color: black\">Alertamiento</span></strong></span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\"><strong><span style=\"color: black\">Pronóstico</span></strong></span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\"><strong><span style=\"color: black\">Inicio</span></strong></span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\"><strong><span style=\"color: black\">Fin</span></strong></span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: black;font-size: 14px\">A202</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: black;font-size: 14px\">Viento normal a moderado en el litoral, valle y cordillera.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black;font-size: 14px\">28-04</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black;font-size: 14px\">28-04</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"color: black;font-size: 14px\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black;font-size: 14px\">Asimismo, conforme a lo indicado en el Informe de Amenaza Meteorológica emitido la presente jornada, se estiman los siguientes montos de precipitaciones (mm) y velocidad de viento (km/h) para el martes 28 de abril:</span></p><p><span style=\"font-size: 14px\"><br></span></p><table><tbody><tr><td><p style=\"text-align: center\"><span style=\"font-size: 14px\"><strong><span style=\"color: black\">Sector</span></strong></span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\"><strong><span style=\"color: black\">Precipitaciones</span></strong></span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\"><strong><span style=\"color: black\">Viento</span></strong></span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">Litoral</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">10 – 20</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">40 – 60</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">Cordillera de la costa</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">10 – 25</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">40 – 60</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">Valle</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">15 – 30</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">25 – 40 rachas 60</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">Precordillera</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">20 – 45</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">40 - 60</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">Cordillera</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">15 – 35</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 14px\">40 – 60 rachas 80</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"color: black;font-size: 14px\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black;font-size: 14px\">Por otra parte, el Servicio Meteorológico de la Armada de Chile mantiene vigente un Aviso de Mal Tiempo entre Isla Mocha y Corral, desde el martes 28 de abril.</span></p><p style=\"text-align: justify\"><span style=\"color: black;font-size: 14px\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black;font-size: 14px\">En consideración a estos antecedentes, la Dirección Regional del SENAPRED La Araucanía&nbsp;<strong>declara Alerta Temprana Preventiva Regional por evento meteorológico</strong></span><span style=\"color: black;font-size: 14px\">, vigente desde hoy y hasta que las condiciones meteorológicas así lo ameriten.</span></p><p style=\"text-align: justify\"><span style=\"color: black;font-size: 14px\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black;font-size: 14px\">La declaración de esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
