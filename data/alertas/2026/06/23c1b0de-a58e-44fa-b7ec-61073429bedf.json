	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región del Libertador Gral. Bernardo O'Higgins\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De acuerdo con la información&nbsp;técnica proporcionada por Conaf y el SINAPRED,&nbsp;</span></strong><span style=\"font-size:15px\">respecto al incendio forestal en la&nbsp;<strong>comuna de Pichilemu, </strong>se informa el siguiente detalle:</span></p><p style=\"text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><table><tbody><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Nombre   del incendio</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Rincón   del Potrero</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Estado</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">En   combate</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Superficie</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">120   (ha)</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Observaciones</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">El incendio se encuentra   en intensidad media en general, con velocidad de propagación lenta,   intensidad del frente media y longitud de llama baja; con reactivaciones   producto del incremento del viento.</span></p><p><span style=\"color: rgb(0, 0, 0)\">No se reportan   afectaciones en personas ni daños en viviendas en la comuna de Pichilemu.</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">En consideración a este antecedente y en base a la información técnica proporcionada por CONAF, la&nbsp;</span><span style=\"color: black\">Dirección Regional de SENAPRED mantiene la Alerta Amarilla para la Comuna de Pichilemu, por incendio forestal, que se encuentra vigente desde el 28 de junio de 2026.</span></p>",
