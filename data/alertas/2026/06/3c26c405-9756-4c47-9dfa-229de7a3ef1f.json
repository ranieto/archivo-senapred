	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región del Libertador Gral. Bernardo O'Higgins\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De acuerdo con la información&nbsp;técnica proporcionada por Conaf y el SINAPRED,&nbsp;</span></strong><span style=\"font-size:15px\">respecto al incendio forestal en la&nbsp;<strong>comuna de Pichilemu, </strong>se informa el siguiente detalle:</span></p><table><tbody><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Nombre   del incendio</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Rincón   del Potrero</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Estado</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">En   combate</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Superficie</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">120   (ha)</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Recursos</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">-&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;   </span><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Bomberos de Pichilemu.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">-&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;   </span><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Técnico de Conaf.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">-&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;   </span><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">3 Brigadas de Conaf.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">-&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;   </span><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">2 Aeronaves.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">-&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;   </span><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">2 Skidders.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">-&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;   </span><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">2 Camiones Aljibe.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">-&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;   </span><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">1 Tractor CEF TANUME.</span></p></td></tr></tbody></table><p><span style=\"color: rgb(0, 0, 0)\">En consideración a este antecedente y en base a la información técnica proporcionada por CONAF, en coordinación con la Delegación Presidencial Regional de Libertador General Bernardo O'Higgins, la Dirección Regional de SENAPRED mantiene la Alerta Amarilla para la Comuna de Pichilemu, por incendio forestal, que se encuentra vigente desde el 28 de junio de 2026.</span></p>",
