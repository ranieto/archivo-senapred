	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de los Ríos\",\"nombreVariable\":\"Viento - Temporal viento\",\"nombreImg\":\"viento.png\"}",
	"contenido": "<p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De acuerdo con la <strong>información proporcionada por la Dirección Meteorológica de Chile (DMC),</strong> se encuentran vigentes los siguientes alertamientos meteorológicos para la Región de Los Ríos:</span></p><table><tbody><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Alertamiento</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Pronóstico</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Inicio</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Fin</strong></span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">Alerta AA81</span></p></td><td><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Viento moderado a fuerte en precordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">01-07</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">01-07</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">Aviso A285-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Viento normal a moderado en precordillera y cordillera, con dirección   Este (Raco, Puelche).</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">30-06</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">02-07</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Asimismo, según los alertamientos las velocidades de viento en km/h que se pronostican son las siguientes:</span></p><div><table><tbody><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Zona</strong></span></p></td><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Martes 30</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Miércoles 01</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Jueves 02</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">Precordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">40 – 60 rachas 70</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">40 – 60 rachas 100</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">40 – 60 rachas 70</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">Cordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">60 – 80 </span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">60 – 80 </span></p></td></tr></tbody></table></div><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"><span style=\"font-size: 15px\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Los Ríos, la Dirección Regional del SENAPRED <strong>declara Alerta Temprana Preventiva por viento para las comunas de Panguipulli, Futrono, Río Bueno y Lago Ranco</strong>, vigente a contar de hoy y hasta que las condiciones meteorológicas lo ameriten.</span></span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"></span></p><p style=\"text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">La declaración de esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0);font-size: 15px\"><strong>SENAPRED</strong></span><span style=\"color: black;font-size: 15px\">&nbsp;recomienda a la población&nbsp;informarse sobre las condiciones del tiempo; y alejarse del tendido eléctrico, grandes árboles y carteles publicitarios, ya que podrían colapsar debido al viento.&nbsp;</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
