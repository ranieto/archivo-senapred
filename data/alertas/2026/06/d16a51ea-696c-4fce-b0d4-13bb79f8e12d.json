	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región del Biobío\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"color: black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC), ha sido cancelado el siguiente alertamiento meteorológico para la Región del Biobío, debido al término de las condiciones meteorológicas que lo originaron:</span></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Pronóstico</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A241</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones   Normales a Moderadas en corto periodo de tiempo en zonas de la región.</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><br></p><p style=\"text-align:justify\"><span style=\"color:black\">​</span></p><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a este antecedente, la Dirección Regional del SENAPRED del Biobío <strong>cancela la Alerta Temprana Preventiva Regional por evento meteorológico</strong></span><strong><span style=\"color:black\">, </span></strong><span style=\"color:black\">que se mantuvo vigente desde el 01 de junio de 2026.</span></p>",
