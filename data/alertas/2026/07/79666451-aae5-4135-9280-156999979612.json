	"titulo": "Se cancela Alerta Amarilla para la comuna de Los Vilos por incendio forestal",
	"fechaHora": "2026-07-02T21:17:08.088-04:00",
	"createdAt": "2026-07-03T01:20:47.873Z",
	"updatedAt": "2026-07-03T01:42:36.216Z",
