	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región de Coquimbo\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"color: rgb(0, 0, 0);font-size: 14px\">De acuerdo con la información&nbsp;técnica proporcionada por Conaf&nbsp;</span></strong><span style=\"color: black;font-size: 14px\">respecto al incendio forestal en la comuna de Los Vilos, se informa el siguiente detalle:</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><div style=\"text-align: justify\"><table><tbody><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><a name=\"_Hlk182357831\"><strong>Nombre del incendio</strong></a></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cerro Blanco</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Estado</strong></span></p></td><td><p><span style=\"color:#000000\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Controlado</span></span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Superficie aproximada</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">445 hectáreas&nbsp;</span></p></td></tr><tr><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Observaciones</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><span style=\"font-size: 14px\">No se reportan afectaciones en personas ni daños en viviendas a raíz de este incendio.</span></span></p></td></tr></tbody></table></div><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px\"><span style=\"color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en coordinación con la delegación Presidencial Regional de Coquimbo, la Dirección Regional de SENAPRED </span><strong><span style=\"color: rgb(0, 0, 0)\">cancela la Alerta Amarilla para la comuna de Los Vilos por incendio forestal</span></strong><span style=\"color: rgb(0, 0, 0)\">, que se mantuvo vigente desde el 30 de junio de 2026.</span></span></p>",
	"tipoAlertaId": "00c5c83a-4e44-4f7e-b589-bdb0b0ddde88",
