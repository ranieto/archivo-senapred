	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de Antofagasta\",\"nombreVariable\":\"Viento - Temporal viento\",\"nombreImg\":\"viento.png\"}",
	"contenido": "<p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC), se encuentran vigentes los siguientes alertamientos meteorológicos para la Región de Antofagasta:</span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Fin</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Alerta AA93</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Viento moderado a fuerte, con desarrollo de viento blanco, en   cordillera de la costa, precordillera Alto Loa y cordillera de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">16-07</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">18-07</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A320-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Viento normal a moderado, con probabilidad de viento blanco, en   precordillera occidental, precordillera Alto Loa, precordillera salar y   cordillera de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">15-07</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">19-07</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size:15px;color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">Asimismo, conforme a lo indicado los alertamientos vigentes, los montos de viento (km/h) pronosticados para los próximos días en la región, son los siguientes:</span></p><div><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Zona</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Miércoles 15</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Jueves 16</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Viernes 17</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Sábado 18</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Domingo 19</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera de la Costa</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">80 - 100</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">80 - 100</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">80 - 100</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Precordillera Occidental</span></p></td><td></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">60 – 80 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">60 – 80 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">60 – 80 </span></p></td><td rowspan=\"2\"><p style=\"text-align:center\"><span style=\"color:black\">60 – 80 </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Precordillera Alto Loa</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">80 – 100 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">80 – 100 </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Precordillera Salar</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">-</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40 - 60 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40 - 60 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40 - 60 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">40 – 60 </span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Cordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">50 - 70</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">70 - 90 </span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">80 - 100</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">80 - 100</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">60 – 80 </span></p></td></tr></tbody></table></div><p style=\"text-align:justify\"><br></p><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Antofagasta, la Dirección Regional del SENAPRED <strong>mantiene la Alerta Temprana Preventiva regional por viento</strong>, el que se encuentra vigente desde el 12 de julio y hasta que las condiciones meteorológicas así lo ameriten.</span></p><p style=\"text-align:justify\"></p><p style=\"text-align: justify\"><span style=\"font-size:15px;color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">Esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
	"variableRiesgoAlertasId": "eee335b5-4fea-40b4-803e-b6ce1ed722a2"
}
