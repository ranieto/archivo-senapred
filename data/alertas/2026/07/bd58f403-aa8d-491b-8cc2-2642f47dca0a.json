	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de Antofagasta\",\"nombreVariable\":\"Precipitaciones - Sistema frontal\",\"nombreImg\":\"precipitacionessistemafrontal.png\"}",
	"contenido": "<p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De acuerdo con la <strong>información proporcionada por la Dirección Meteorológica de Chile (DMC),</strong> se encuentran vigentes los siguientes alertamientos meteorológicos para la Región de Antofagasta:</span></p><table><tbody><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size:15px;color:black\">Alertamiento</span></strong></p></td><td><p style=\"text-align:justify\"><strong><span style=\"font-size:15px;color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:justify\"><strong><span style=\"font-size:15px;color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:justify\"><strong><span style=\"font-size:15px;color:black\">Fin</span></strong></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">Alerta AA117-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">Precipitaciones moderadas a fuertes en sector   costero, Paposo al sur.</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">31-07</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">31-07</span></p></td></tr><tr><td colspan=\"4\"><p style=\"text-align:justify\"><span style=\"font-size:15px\">Enlace alertamiento: </span><span style=\"font-size:15px\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_AA117-1_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7Cc586e3704f3746e26a2f08deee6f7c8b%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639210359803400246%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=DG4mGfVreWf2bE4x3TM8ugYUaIeWNcMH3EHoT4LX%2BEU%3D&amp;reserved=0\">https://archivos.meteochile.gob.cl/portaldmc/AAA/doc/evento_AA117-1_2026.php</a></span></p></td></tr></tbody></table><table><tbody><tr><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">Aviso A367-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">Precipitaciones normales a moderadas en   litoral.</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">31-07</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size:15px\">31-07</span></p></td></tr><tr><td colspan=\"4\"><p style=\"text-align:justify\"><span style=\"font-size:15px\">Enlace alertamiento: </span><span style=\"font-size:15px\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A367-1_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7Cc586e3704f3746e26a2f08deee6f7c8b%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639210359803566818%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=dTS7K%2BVCWe5eusG3aRI70gEg6CKDLcVM9p5lzlLabWg%3D&amp;reserved=0\">https://archivos.meteochile.gob.cl/portaldmc/AAA/doc/evento_A367-1_2026.php</a></span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Antofagasta, la Dirección Regional del SENAPRED <strong>modifica cobertura de la Alerta Temprana Preventiva por precipitaciones para las comunas de Antofagasta, Taltal, Mejillones y Tocopilla</strong>, que se encuentra vigente desde el 27 de julio y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
