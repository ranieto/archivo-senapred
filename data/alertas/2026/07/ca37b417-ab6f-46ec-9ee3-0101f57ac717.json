	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de los Ríos\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">De acuerdo con la <strong>información proporcionada por la Dirección Meteorológica de Chile (DMC),</strong> se encuentran vigentes los siguientes alertamientos meteorológicos para la Región de </span><span style=\"font-size:15px;color:black\">Los Ríos</span><span style=\"font-size:15px;color:black\">:</span></p><p style=\"text-align: justify\"><span style=\"font-size:15px;color:black\"><br></span></p><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Fin</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Alerta AA106-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">viento moderado a fuerte en litoral, cordillera costa y cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">23-07</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">23-07</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A342-4</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">viento normal a moderado en valle y precordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">23-07</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">23-07</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A348</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Probable desarrollo de tormentas eléctricas en el litoral.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">23-07</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">23-07</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color:black\">Aviso A351</span></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Precipitaciones normales a moderadas en el litoral, cordillera de la   costa, valle, precordillera y cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">24-07</span></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">25-07</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size:15px;color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">Así mismo, conforme a lo indicado en los alertamientos meteorológicos vigentes de la DMC, los montos pronosticados de precipitaciones (mm/cm) y viento (km/h) son los siguientes:</span></p><div><table><tbody><tr><td><p><strong><span style=\"color:black\">Zona</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Viento Jueves 23</span></strong></p></td><td rowspan=\"6\"><p style=\"text-align:center\"></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Precipitaciones Sábado 25</span></strong></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">Litoral</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">40-60racha90</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">50-70</span></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">Cordillera de la costa</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">40-60racha90</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">50-75</span></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">Valle longitudinal</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">40-60racha80</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">30-50</span></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">Precordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">40-60racha80</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">30-65</span></p></td></tr><tr><td><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">Cordillera</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">40-60racha90</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">5-15 mm/ 40-60   cm</span></p></td></tr></tbody></table></div><p style=\"text-align:justify\"><span style=\"font-size:12px;color:black\">Nota: montos de precipitaciones contemplan el período entre las 08:00 horas del día indicado y las 08:00 horas del día siguiente.</span></p><p style=\"text-align:justify\"><br></p><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Los Ríos, la Dirección Regional del SENAPRED <strong>mantiene la Alerta Temprana Preventiva regional a evento meteorológico</strong>, vigente desde el 21 de julio de 2026 y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align:justify\"></p><p style=\"text-align: justify\"><span style=\"font-size:15px;color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size:15px;color:black\">Esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
	"variableRiesgoAlertasId": "07c971d4-5263-4093-a326-9a18e4399518"
