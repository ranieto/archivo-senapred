portaldmc%2FAAA%2Fdoc%2Fevento_AA146-1_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C2675810520764c4ed0e008df02d643da%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639232791450619454%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=0Dy9LSGwXayQ%2FJVmn0pHxEWkEgjOx6iXq0woyHyg%2FtE%3D&amp;reserved=0\"><u><span style=\"font-size: 14px;color: rgb(0, 85, 255)\">aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso A437-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Viento   normal a moderado en litoral, cordillera costa, valle, precordillera y   cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">24-08</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">27-08</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A437-2_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C2675810520764c4ed0e008df02d643da%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639232791450629062%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=a2LZkqK8Ta6R47pD9lnpo1kpolvAkHrRtk9rWUW7Qvw%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir </span></u></a><u><br></u><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A437-2_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C2675810520764c4ed0e008df02d643da%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639232791450629062%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=a2LZkqK8Ta6R47pD9lnpo1kpolvAkHrRtk9rWUW7Qvw%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">   aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso A438-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Precipitaciones   normales a moderadas en litoral, cordillera de la costa y valle.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">25-08</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">26-08</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A438-2_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C2675810520764c4ed0e008df02d643da%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639232791450638112%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=sTEKe3c3%2F3iNja0QWt%2FtO8SfDOFv15MgGTEZ1hDPZ4c%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir </span></u></a><u><br></u><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A438-2_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C2675810520764c4ed0e008df02d643da%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639232791450638112%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=sTEKe3c3%2F3iNja0QWt%2FtO8SfDOFv15MgGTEZ1hDPZ4c%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">   aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso A439-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Precipitaciones   normales a moderadas con isoterma cero alta en cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">25-08</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">25-08</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A439-2_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C2675810520764c4ed0e008df02d643da%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639232791450647117%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=R5Y9gu4L5pPiGpUsYqak4uT3B1%2FCp24pjUbdNpW7arw%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir </span></u></a><u><br></u><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A439-2_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C2675810520764c4ed0e008df02d643da%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639232791450647117%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=R5Y9gu4L5pPiGpUsYqak4uT3B1%2FCp24pjUbdNpW7arw%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">   aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso A450-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Probables   tormentas eléctricas con probabilidad de fuertes rachas de vientos locales en   zonas del litoral, cordillera de la costa, valle, precordillera y cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">26-08</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">27-08</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A450-1_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C2675810520764c4ed0e008df02d643da%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639232791450656082%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=cb3EQSj74Qc9E8gf1aowatoXhDorHprXrFmIbsi3SGo%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir </span></u></a><u><br></u><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A450-1_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C2675810520764c4ed0e008df02d643da%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639232791450656082%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=cb3EQSj74Qc9E8gf1aowatoXhDorHprXrFmIbsi3SGo%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">   aquí</span></u></a></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Por otra parte, el Servicio Nacional de Geología y Minería (SERNAGEOMIN), mediante la actualización de su Minuta Técnica por <strong>peligro de remoción en masa</strong>, indica que la posibilidad de ocurrencia de aluviones (flujos de detritos) y derrumbes (deslizamientos, caídas de rocas) es <strong>Alta</strong> en cordillera de la costa, precordillera y cordillera; <strong>Moderada</strong> en litoral y valle.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Asimismo, la <strong>Dirección General del Territorio Marítimo y Marina Mercante</strong> (DIRECTEMAR) mediante su <strong>Aviso N°32A</strong>, pronostica un aviso de mal tiempo y temporal en área oceánica y costera entre sector Boyeruca a Corral, desde el martes 25 al jueves 27 de agosto.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional del Biobío, la Dirección Regional del SENAPRED <strong>mantiene la Alerta Temprana Preventiva Regional por evento meteorológico</strong>, la que se encuentra vigente desde el 21 de agosto y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
