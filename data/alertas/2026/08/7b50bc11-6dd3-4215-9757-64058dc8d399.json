C02%7Cperiodistadeturno%40senapred.gob.cl%7Ccfc68c64b4364d2e5d7008defd3db599%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639226638709226217%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=vfgButgMLz%2BxcfHpNELUEER00zOWXgrVQIE6Ebxs45c%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir   aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso   A388-9</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Viento normal a   moderado con probabilidad de tormentas de arena en pampa, precordillera y   cordillera de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">17-08</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">18-08</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A388-9_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7Ccfc68c64b4364d2e5d7008defd3db599%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639226638709236897%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=Doh3VymtIh5IsfBycYm8r51r4k0CtTESS%2FImuVBzSEg%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso   A421-3</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Precipitaciones   normales a moderadas en litoral, cordillera de la costa, valle y pampa de la   región.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">18-08</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">18-08</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A421-3_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7Ccfc68c64b4364d2e5d7008defd3db599%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639226638709246227%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=tU0%2FYaMsGURvfwPHl7y0fSdh4alrissy7CqlmaUlut4%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso   A422-2</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Probables nevadas   en precordillera de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">17-08</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">19-08</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A422-2_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7Ccfc68c64b4364d2e5d7008defd3db599%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639226638709255453%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=W8eQEDbzanCMGtIkPTBTbco48MRBCejr75Ibx1al4f4%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso   A425-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Nevadas normales a   moderadas en cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">17-08</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">19-08</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A425-1_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7Ccfc68c64b4364d2e5d7008defd3db599%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639226638709264703%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=%2BbMfxo6sSbE8V5Gtpi8zJZVvJRCR2vAuO8KAnmCKhYs%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso   A428</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Probables   tormentas eléctricas con probabilidad de precipitaciones fuertes en corto   periodo de tiempo en litoral, cordillera de la costa, valle, pampa y   precordillera de la región.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">17-08</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">19-08</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A428_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7Ccfc68c64b4364d2e5d7008defd3db599%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639226638709273950%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=q4gASC0Mcp1xg5D3ItmGDaypxFPbeIdYXxhBIiUpU8s%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir aquí</span></u></a></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Por otra parte, el Servicio Nacional de Geología y Minería (SERNAGEOMIN), mediante la actualización de su <strong>Minuta Técnica por peligro de remoción en masa,</strong> indica que la posibilidad de ocurrencia de aluviones (flujos de detritos) y derrumbes (deslizamientos, caídas de rocas) es <strong>alta </strong>en litoral, precordillera y valles precordilleranos y <strong>moderada</strong> en cordillera de la costa, valles transversales, pampa y cordillera.</span></p><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Atacama, la Dirección Regional del SENAPRED <strong>mantiene la Alerta Amarilla Regional por evento meteorológico</strong>, que se encuentra vigente desde el 10 de agosto y hasta que las condiciones así lo ameriten. </span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Con esta Alerta Amarilla, permanecerán alistados escalonadamente los recursos necesarios para intervenir de acuerdo con la evolución del evento, con el objeto de evitar que este crezca en extensión y severidad, minimizando los efectos negativos en las personas, sus bienes y el medio ambiente.</span></p>",
