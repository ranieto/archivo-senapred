	"urlAccess": "se-declara-alerta-temprana-preventiva-para-la-provincia-de-parinacota-y-la-comuna-de-camarones-por-evento-meteorologico-2026-08-08-13-51-59",
	"parentId": "eb7359fb-e673-4f3b-b641-10139c0e6172",
