	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de Ñuble\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"color: black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC), se encuentra vigente el siguiente alertamiento meteorológico para la Región de Ñuble:</span></p><div><br></div><div><table><tbody><tr><td><p style=\"text-align: center\"><strong><span style=\"color: black\">Alertamiento</span></strong></p></td><td><p><strong><span style=\"color: black\">Pronóstico</span></strong></p></td><td><p style=\"text-align: center\"><strong><span style=\"color: black\">Inicio</span></strong></p></td><td><p style=\"text-align: center\"><strong><span style=\"color: black\">Fin</span></strong></p></td><td><p style=\"text-align: center\"><strong><span style=\"color: black\">Enlace</span></strong></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: black\">Aviso A465-2</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: black\">Viento normal a moderado con de dirección Este (Raco, Puelche) en precordillera y cordillera.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black\">05-09</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black\">06-09</span></p></td><td><p style=\"text-align: center\"><u><span style=\"color: rgb(68, 114, 196)\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A465-2_2026.php&amp;data=05%7C02%7Cnbanda%40senapred.gob.cl%7C037628c4400f432621a908df0a9e5a61%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639241347398437619%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=oPIkTgMDneTWxELriw%2BoeUrg60hy4NGK1yLi9aFaz2k%3D&amp;reserved=0\"><span style=\"color: rgb(68, 114, 196)\">Abrir<br>aquí</span></a></span></u></p></td></tr></tbody></table></div><p style=\"text-align: justify\"><br></p><p style=\"text-align: justify\"><span style=\"color: black\">En consideración a este antecedente y en coordinación con la Delegación Presidencial Regional de Ñuble, la Dirección Regional del SENAPRED&nbsp;</span><strong><span style=\"color: black\">declara Alerta Temprana Preventiva Regional por evento meteorológico</span></strong><span style=\"color: black\">, vigente a contar de hoy y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align: justify\"><span style=\"color: black\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black\">La declaración de esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
