	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de Atacama\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"color: black\">De acuerdo con la </span><strong><span style=\"color: black\">información proporcionada por la Dirección Meteorológica de Chile (DMC)</span></strong><span style=\"color: black\">, se encuentra vigente el siguiente alertamiento meteorológico para la Región de Atacama:</span></p><p><span style=\"color: black\"><br></span></p><div><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Inicio</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Fin</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Enlace</span></strong></p></td></tr><tr><td><p style=\"text-align:center\">Aviso   A509</p></td><td><p style=\"text-align:justify\">Viento normal a   moderado en el litoral de la Provincia de Huasco, con probabilidad de   tormentas de arena.</p></td><td><p style=\"text-align:center\">28-09</p></td><td><p style=\"text-align:center\">30-09</p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A509_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C3bf4a208e9b04930915208df1ce1f4fc%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639261428992518862%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=uerRECT4Kqv8A5Q1Kfq6wBO2Z7KWr1TVhvFBB19n%2FwQ%3D&amp;reserved=0\">Abrir Aquí</a></p></td></tr></tbody></table></div><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"color:black\">Por otra parte, debido al debilitamiento de las condiciones que lo originaron ha sido cancelado el siguiente alertamiento meteorológico para la región:</span></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><div><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Alertamiento</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Pronóstico</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Enlace</span></strong></p></td></tr><tr><td><p style=\"text-align:center\">Aviso   A501-2</p></td><td><p style=\"text-align:justify\">Altas temperaturas   en precordillera.</p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fcancela_evento_A501-2_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C3bf4a208e9b04930915208df1ce1f4fc%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639261428992535801%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=DfB4MJ9eiFcn5yTJ7GfM1LyD5R3O7FcW8oTSz6X3k4c%3D&amp;reserved=0\">Abrir Aquí</a></p></td></tr></tbody></table></div><p style=\"text-align:justify\"><br></p><p style=\"text-align:justify\"><span style=\"color:black\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Atacama, la Dirección Regional del SENAPRED <strong>modifica el&nbsp;</strong></span><strong>evento y cobertura de la Alerta Temprana Preventiva a las comunas de Huasco y Freirina por viento</strong><span style=\"color: black\">, vigente desde el 21 de septiembre y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align:justify\"></p><p style=\"text-align: justify\"><span style=\"color:black\"><br></span></p><p style=\"text-align:justify\"><span style=\"color:black\">La modificación de esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
	"variableRiesgoAlertasId": "07c971d4-5263-4093-a326-9a18e4399518"
}
