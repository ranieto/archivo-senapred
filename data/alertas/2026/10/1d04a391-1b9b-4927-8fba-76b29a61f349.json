98608df2234a4ce%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639267281683382328%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=y8D9FMrO9jeUP0PNYvpw083%2B56z5IP7oVkmYqkfRfMk%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">   aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso A534-1</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Precipitaciones   normales a moderadas en cordillera de la costa, valle, precordillera y   cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">06-10</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">07-10</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A534-1_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C0e01a11a1e714468798608df2234a4ce%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639267281683394083%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=8ujvE7dVMU4pXMt7Anmcvp2QbdNbkmJocWAT2gh%2Fghc%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir </span></u></a><u><br></u><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A534-1_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C0e01a11a1e714468798608df2234a4ce%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639267281683394083%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=8ujvE7dVMU4pXMt7Anmcvp2QbdNbkmJocWAT2gh%2Fghc%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">   aquí</span></u></a></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Aviso A535</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Probables   tormentas eléctricas en cordillera de la costa, valle, precordillera y   cordillera.</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">06-10</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">08-10</span></p></td><td><p style=\"text-align:center\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A535_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C0e01a11a1e714468798608df2234a4ce%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639267281683404388%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=NQ5jUs617Dg9o6yh7dh1PcYvBXqABpVQwgRZ%2BlBPnF4%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">Abrir </span></u></a><u><br></u><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A535_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C0e01a11a1e714468798608df2234a4ce%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639267281683404388%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=NQ5jUs617Dg9o6yh7dh1PcYvBXqABpVQwgRZ%2BlBPnF4%3D&amp;reserved=0\"><u><span style=\"color: rgb(0, 85, 255)\">   aquí</span></u></a></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Por otra parte, según lo señalado en el Informe de Amenaza Meteorológica, se pronostican los siguientes montos de precipitaciones, viento e isoterma 0°C en la región: </span></p><ul type=\"disc\"><li><strong>Precipitaciones:</strong> entre 1 y 39 mm.</li><li><strong>Nevadas:</strong> entre 30 y 60 cm.</li><li><strong>Viento:      </strong>25 – 60 km/h<strong>.</strong></li><li><strong>Isoterma      0:</strong>&nbsp; entre 2.200 – 3.700 m.s.n.m. </li></ul><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Finalmente, el Servicio Nacional de Geología y Minería (SERNAGEOMIN), mediante su <strong>Minuta Técnica por peligro de remoción en masa,</strong> indica que la posibilidad de ocurrencia de aluviones (flujos de detritos) y derrumbes (deslizamientos, caídas de rocas) es la siguiente:</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><table><tbody><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Sector</strong></span></p></td><td><p><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><strong>Posibilidad</strong></span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cordillera de la costa</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Moderada</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Valle</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Moderada</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Precordillera</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Moderada</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Cordillera</span></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">Baja</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 14px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional Metropolitana, la Dirección Regional del SENAPRED <strong>mantiene Alerta Temprana Preventiva regional por evento meteorológico,</strong> que se mantiene vigente desde el 02 de octubre y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0);font-size: 14px\">Esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
