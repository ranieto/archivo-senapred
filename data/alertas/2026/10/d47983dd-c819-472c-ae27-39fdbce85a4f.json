	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de Valparaíso\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"color: black\">De acuerdo con la información proporcionada por la Dirección Meteorológica de Chile (DMC), se encuentran vigentes los siguientes alertamientos meteorológicos para la Región de Valparaíso:</span></p><p><span style=\"color: black\"><br></span></p><p><span style=\"color: black\"><br></span></p><div><br></div><div><table><tbody><tr><td><p style=\"text-align: center\"><strong><span style=\"color: black !important\">Alertamiento</span></strong></p></td><td><p><strong><span style=\"color: black !important\">Pronóstico</span></strong></p></td><td><p style=\"text-align: center\"><strong><span style=\"color: black !important\">Inicio</span></strong></p></td><td><p style=\"text-align: center\"><strong><span style=\"color: black !important\">Fin</span></strong></p></td><td><p style=\"text-align: center\"><strong><span style=\"color: black !important\">Enlace</span></strong></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: black !important\">Alerta AA174</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: black !important\">Precipitaciones moderadas a fuertes en litoral, cordillera de la costa, precordillera y valles precordilleranos.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\">06-10</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\">07-10</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\"><a rel=\"noopener noreferrer\" href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_AA174_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C362694384e7e4b30acd808df2327292d%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639268323272911531%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=QunHPxHDH3eAZcDeYzKZ%2BOQ3604UYeNNuXWAIIavOZ8%3D&amp;reserved=0\">Abrir<br>aquí</a></span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: black !important\">Aviso A531-3</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: black !important\">Viento normal a moderado en litoral, cordillera de la costa y cordillera.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\">05-10</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\">08-10</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\"><a rel=\"noopener noreferrer\" href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A531-3_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C362694384e7e4b30acd808df2327292d%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639268323272927879%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=Ittbwm8RdKSsH7MZeeDEoIGNrIxcwbHt1kY6vNgM480%3D&amp;reserved=0\">Abrir<br>aquí</a></span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: black !important\">Aviso A534-2</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: black !important\">Precipitaciones normales a moderadas en cordillera.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\">06-10</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\">07-10</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\"><a rel=\"noopener noreferrer\" href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A534-2_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C362694384e7e4b30acd808df2327292d%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639268323272938610%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=mdtz0B6tXPx5R6xj%2FP36Pov0d7RqXlSkMwUgT9TgKbQ%3D&amp;reserved=0\">Abrir<br>aquí</a></span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: black !important\">Aviso A535</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: black !important\">Probables tormentas eléctricas con probabilidad de granizos y fuertes rachas de vientos locales en cordillera de la costa, precordillera y valles precordilleranos y cordillera.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\">07-10</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\">08-10</span></p></td><td><p style=\"text-align: center\"><span style=\"color: black !important\"><a rel=\"noopener noreferrer\" href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A535_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C362694384e7e4b30acd808df2327292d%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639268323272948996%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=Ft64cIa%2FOkeVnS8R9586If8WPMehe09fJLwMSNldADc%3D&amp;reserved=0\">Abrir<br>aquí</a></span></p></td></tr></tbody></table></div><p style=\"text-align: justify\"><br></p><p style=\"text-align: justify\"><span style=\"color: black !important\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black !important\">Por otra parte, el Servicio Nacional de Geología y Minería (SERNAGEOMIN), mediante su <strong>Minuta Técnica por peligro de remoción en masa,</strong> indica que la posibilidad de ocurrencia de aluviones (flujos de detritos) y derrumbes (deslizamientos, caídas de rocas) es <strong>Alta </strong>en valles precordilleranos y precordillera, <strong>Moderada </strong>en litoral y cordillera de la costa y <strong>Baja</strong> en cordillera.</span></p><p style=\"text-align: justify\"><span style=\"color: black !important\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black !important\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black !important\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Valparaíso, la Dirección Regional del SENAPRED </span><strong><span style=\"color: black !important\">mantiene la Alerta Temprana Preventiva regional (continental) por evento meteorológico,</span></strong><span style=\"color: black !important\"> que se encuentra vigente desde el 04 de octubre y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align: justify\"><span style=\"color: black !important\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black !important\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: black !important\">La declaración de esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
	"tipoAlertaId": "a2c18198-064d-47eb-8cfb-87dc64a974c0",
	"variableRiesgoAlertasId": "07c971d4-5263-4093-a326-9a18e4399518"
}
