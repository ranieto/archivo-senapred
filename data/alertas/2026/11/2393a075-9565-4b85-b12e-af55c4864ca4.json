	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"a\",\"comunas\":\"\",\"regiones\":\"Región de Coquimbo\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De acuerdo con la información&nbsp;técnica proporcionada por Conaf y el SINAPRED,&nbsp;</span></strong><span style=\"font-size:15px\">respecto al incendio forestal en la&nbsp;<strong>comuna de Ovalle, </strong>se informa el siguiente detalle:</span></p><table><tbody><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Nombre   del incendio</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Población   El Acacio</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Estado</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Extinguido</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Superficie</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">1.6   (ha)</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Observaciones</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">El   incendio no presentar amenaza a personas, viviendas y/o infraestructura crítica.</span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en base a la información técnica proporcionada por CONAF, en coordinación con la delegación Presidencial Regional de Coquimbo, la Dirección Regional de SENAPRED cancela la Alerta Amarilla para la Comuna de Ovalle, por incendio forestal, que se mantuvo vigente desde el 11 de noviembre.</span></p>",
