	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de Magallanes y de la Antártica Chilena\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De acuerdo con la <strong>información proporcionada por la Dirección Meteorológica de Chile (DMC),</strong> se encuentra vigente el siguiente alertamiento meteorológico para la Región de Magallanes:</span></p><p style=\"text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><table><tbody><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Alertamiento</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Pronóstico</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Inicio</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Fin</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Enlace</strong></span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">Aviso A635</span></p></td><td><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Probables   tormentas eléctricas en cordillera austral norte, cordillera austral sur,   insular central, insular sur, pampa patagónica norte y pampa patagónica sur   de la región</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">22-11</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">24-11</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A635_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C83aaa1ad98754c7d921708df48ec8bb4%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639309852967566172%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=ZOotNAQGdY6GspnllIkqMcn%2F44bFwjjMzaebQMZGuQQ%3D&amp;reserved=0\"><span style=\"color:#0563C1\">Abrir   aquí</span></a></span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">Aviso A642</span></p></td><td><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Viento   normal a moderado en Cordillera Austral Sur, Insular Central, Pampa   Patagónica Norte y Pampa Patagónica Sur.</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">25-11</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">26-11</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A642_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C83aaa1ad98754c7d921708df48ec8bb4%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639309852967582406%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=3G9j8QNEonEcu9kStYFhsSYBu4m9btQqVNszpCPXmNc%3D&amp;reserved=0\"><span style=\"color:#0563C1\">Abrir   aquí</span></a></span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">Aviso A643</span></p></td><td><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Precipitaciones   normales a moderadas en Cordillera Austral Norte y Pampa Patagónica Norte.</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">25-11</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">26-11</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A643_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C83aaa1ad98754c7d921708df48ec8bb4%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639309852967592685%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=%2BBeEFfk7RpsFEmb%2BSAGnk0qmap1Sh3rGC5MuEWuzjlY%3D&amp;reserved=0\"><span style=\"color:#0563C1\">Abrir   aquí</span></a></span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Magallanes, la Dirección Regional del SENAPRED <strong>modifica el evento de la Alerta Temprana Preventiva Regional a evento meteorológico</strong>, que se encuentra vigente desde el 21 de noviembre y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"></span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">La modificación de esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
