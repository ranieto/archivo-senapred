	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"v\",\"comunas\":\"\",\"regiones\":\"Región de Magallanes y de la Antártica Chilena\",\"nombreVariable\":\"Tormentas eléctricas\",\"nombreImg\":\"tormentaselectricas.png\"}",
	"contenido": "<p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De acuerdo con <strong>la información proporcionada por la Dirección Meteorológica de Chile (DMC),</strong> se encuentran vigentes los siguientes alertamientos meteorológicos para la Región de Magallanes:</span></p><p style=\"text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><table><tbody><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Alertamiento</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Pronóstico</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Inicio</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Fin</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Enlace</strong></span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">Aviso A631</span></p></td><td><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Probables   tormentas eléctricas en cordillera austral norte, insular norte, pampa   patagónica norte y pampa patagónica sur de la región</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">19-11</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">19-11</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A631_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C85488a17b9cf4fd3f18208df467e4f83%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639307180487137631%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=Z43R4CglZtgxkaXfbL3RxMgI%2BK3E06kyqcLz9BYDmaU%3D&amp;reserved=0\"><span style=\"color:#0563C1\">Abrir   aquí</span></a></span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">Aviso A633</span></p></td><td><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Probables   tormentas eléctricas en las comunas de Torres del Paine, Natales, Laguna   Blanca y San Gregorio</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">20-11</span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">20-11</span></p></td><td><p style=\"text-align:center\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><a href=\"https://nam10.safelinks.protection.outlook.com/?url=https%3A%2F%2Farchivos.meteochile.gob.cl%2Fportaldmc%2FAAA%2Fdoc%2Fevento_A633_2026.php&amp;data=05%7C02%7Cperiodistadeturno%40senapred.gob.cl%7C85488a17b9cf4fd3f18208df467e4f83%7Cc4c70e6abf1c4c55986259a5f3ac8257%7C0%7C0%7C639307180487154152%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=83ueJmk8ofzeNsq0RQaP%2BqjB0jtRggzDukDAyKTY4Es%3D&amp;reserved=0\"><span style=\"color:#0563C1\">Abrir   aquí</span></a></span></p></td></tr></tbody></table><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">En consideración a estos antecedentes y en coordinación con la Delegación Presidencial Regional de Magallanes, la Dirección Regional del SENAPRED <strong>mantiene la Alerta Temprana Preventiva por tormentas eléctricas para las provincias de Magallanes, Última Esperanza y Tierra del Fuego</strong>, la cual se encuentra vigente desde el 18 de noviembre y hasta que las condiciones así lo ameriten.</span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"></span></p><p style=\"text-align:justify\"><span style=\"color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Esta alerta se constituye como un estado de reforzamiento de la vigilancia, mediante el monitoreo preciso y riguroso de las condiciones de riesgo y las respectivas vulnerabilidades asociadas a la amenaza, coordinando y activando al Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED) con el fin de actuar oportunamente frente a eventuales situaciones de emergencia.</span></p>",
