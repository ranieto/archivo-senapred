	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región Metropolitana de Santiago\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><strong><span style=\"color:black\">De acuerdo con la información&nbsp;técnica proporcionada por CONAF,&nbsp;</span></strong><span style=\"color: black\">respecto al incendio forestal en la comuna de Melipilla se informa el siguiente detalle:</span><br></p><table><tbody><tr><td><p style=\"text-align:justify\"><strong><span style=\"color:black\">Nombre del incendio</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">La Palma</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"color:black\">Estado</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Extinguido</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"color:black\">Superficie</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">103 hectáreas</span></p></td></tr><tr><td><p style=\"text-align:justify\"><strong><span style=\"color:black\">Observaciones</span></strong></p></td><td><p style=\"text-align:justify\"><span style=\"color:black\">Al momento, el incendio se encuentra extinguido y afectó 103 hectáreas   de matorral y pastizal, en el camino La Palma/Pomaire, comuna de Melipilla.</span></p></td></tr></tbody></table>",
