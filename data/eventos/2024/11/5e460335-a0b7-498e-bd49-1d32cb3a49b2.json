	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región de Atacama, Región de Valparaíso, Región del Maule, Región Metropolitana de Santiago, Región del Libertador Gral. Bernardo O'Higgins\",\"nombreVariable\":\"Incendio Forestal\",\"nombreImg\":\"incendioforestal.png\"}",
	"contenido": "<p><span style=\"font-size: 17px\">Resumen Nacional de Incendios Forestales para la presente jornada, que comprende las regiones de Atacama, Valparaíso, Metropolitana, O'Higgins y Maule.</span></p><p><strong><span style=\"font-size:17px;color:#E97132\">Alerta Amarilla Región de Valparaíso</span></strong></p><p></p><p><strong><span style=\"font-size:17px;color:#E97132\">Número de mensajes SAE 9</span></strong></p><p></p><p></p><p style=\"margin-left:36.0pt\"><strong><span style=\"font-size:16px\">Región de Valparaíso</span></strong><span style=\"font-size: 16px\">: Continúan en combate los incendios en Quilpué, Villa Alemana, Viña del Mar, Concón, Hijuelas, Limache y Santo Domingo.</span></p><p style=\"margin-left:36.0pt\"><strong><span style=\"font-size:16px\">Otras Regiones</span></strong><span style=\"font-size:16px\">: Incendio controlado en Lampa (Región Metropolitana) y controlado en Mostazal (O'Higgins).</span></p><p><strong><span style=\"font-size:16px\">Detalles Principales:</span></strong></p><p style=\"margin-left:36.0pt\"><span style=\"font-size:16px\">1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><strong><span style=\"font-size:16px\">Quilpué y Villa Alemana</span></strong><span style=\"font-size: 16px\">:</span></p><p style=\"margin-left:72.0pt\"><a name=\"_Hlk182323851\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Incendio:</span></strong></a><span style=\"font-size:16px\">&nbsp;Los Molles |&nbsp;<strong>Hectáreas afectadas:</strong>&nbsp;130</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">SAE:</span></strong><span style=\"font-size:16px\">&nbsp;6 mensajes para evacuar sectores específicos</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Recursos:</span></strong><span style=\"font-size:16px\">&nbsp;Bomberos de Quilpué y Villa Alemana, 7 brigadas, 9 técnicos, 2 aviones cisterna, 2 helicópteros SENAPRED, 4 camiones aljibe y otros equipos de CONAF.</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Nivel de Alerta:</span></strong><span style=\"font-size:16px\">&nbsp;Alerta Roja</span></p><p style=\"margin-left:36.0pt\"><strong><span style=\"font-size:16px\">2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></strong><strong><span style=\"font-size:16px\">Hijuelas:</span></strong></p><p style=\"margin-left:36.0pt\"><strong><span style=\"font-size: 16px\">Incendio:</span></strong><span style=\"font-size:16px\"> Oasis la Campaña <strong>Hectáreas afectadas:</strong>&nbsp;5</span></p><p style=\"margin-left:36.0pt\"><strong><span style=\"font-size: 16px\">SAE:</span></strong><span style=\"font-size: 16px\"> 1 sector Parcelación Oasis la Campana.</span></p><p style=\"margin-left:36.0pt\"><strong><span style=\"font-size: 16px\">Recursos: 2 </span></strong><span style=\"font-size:16px\">técnicos, 1 brigada, 1 avión y Bomberos.</span></p><p style=\"margin-left:72.0pt\"><strong><span style=\"font-size:16px\">Nivel de Alerta:</span></strong><span style=\"font-size:16px\">&nbsp;Alerta Roja</span></p><p style=\"margin-left:36.0pt\"><a name=\"_Hlk182324305\"><strong><span style=\"font-size:16px\">3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></strong><strong><span style=\"font-size:16px\">Viña / Concón</span></strong></a></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Incendio:</span></strong><span style=\"font-size:16px\">&nbsp;Lajarilla |&nbsp;<strong>Hectáreas afectadas:</strong>&nbsp;10</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">SAE:</span></strong><span style=\"font-size:16px\">&nbsp;2 mensaje para evacuar Condominio Maximiliano Viña del Mar y la Cantera y Alto la Cantera, en Concón.</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Recursos:</span></strong><span style=\"font-size:16px\">&nbsp;Bomberos de Viña del Mar, Quintero y Valparaíso; 1 brigada y 2 técnicos de CONAF, 3 helicópteros y 3 aviones cisterna.</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Nivel de Alerta:</span></strong><span style=\"font-size:16px\">&nbsp;Alerta Roja</span></p><p style=\"margin-left:36.0pt\"><span style=\"font-size:16px\">4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><strong><span style=\"font-size:16px\">Limache</span></strong><span style=\"font-size:16px\">:</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Incendio:</span></strong><span style=\"font-size:16px\">&nbsp;Lo Narváez |&nbsp;<strong>Hectáreas afectadas:</strong>&nbsp;5</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">SAE:</span></strong><span style=\"font-size:16px\">&nbsp;No se han emitido</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Recursos:</span></strong><span style=\"font-size:16px\">&nbsp;2 brigadas y 2 técnicos de CONAF, 1 avión cisterna.</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Nivel de Alerta:</span></strong><span style=\"font-size:16px\">&nbsp;Alerta Amarilla <strong>por salir.</strong></span></p><p style=\"margin-left:36.0pt\"><span style=\"font-size:16px\">5.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><strong><span style=\"font-size:16px\">Santo Domingo</span></strong><span style=\"font-size:16px\">:</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Incendio:</span></strong><span style=\"font-size:16px\">&nbsp;Panguirosa |&nbsp;<strong>Hectáreas afectadas:</strong>&nbsp;3</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">SAE:</span></strong><span style=\"font-size:16px\">&nbsp;No se han emitido</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Recursos:</span></strong><span style=\"font-size:16px\">&nbsp;Bomberos de Santo Domingo, 2 brigadas y 2 técnicos de CONAF, 1 camión aljibe.</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Nivel de Alerta:</span></strong><span style=\"font-size:16px\">&nbsp;Alerta Amarilla</span></p><p style=\"margin-left:36.0pt\"><span style=\"font-size:16px\">6.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><strong><span style=\"font-size:16px\">Mostazal (O'Higgins) </span></strong></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Incendio:</span></strong><span style=\"font-size:16px\">&nbsp;Fundo La Querencia |&nbsp;<strong>Hectáreas afectadas:</strong>&nbsp;65.3 (CONTROLADO)</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Recursos:</span></strong><span style=\"font-size:16px\">&nbsp;5 brigadas, 1 técnico de CONAF, 1 helicóptero y 2 camiones aljibe.</span></p><p style=\"margin-left:72.0pt\">o&nbsp;&nbsp;&nbsp; <strong><span style=\"font-size:16px\">Nivel de Alerta:</span></strong><span style=\"font-size:16px\">&nbsp;Alerta Amarilla</span></p>",
