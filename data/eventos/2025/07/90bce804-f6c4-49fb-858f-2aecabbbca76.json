	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región de Atacama, Región de Coquimbo, Región de la Araucanía, Región de Valparaíso, Región del Libertador Gral. Bernardo O'Higgins, Región del Maule, Región del Biobío, Región de los Lagos, Región Metropolitana de Santiago, Región de los Ríos, Región de Ñuble\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"font-size: 15px;color: black\">De acuerdo con la información proporcionada por las Direcciones Regionales del SENAPRED, en el contexto del sistema frontal que se desarrolla entre las regiones de Atacama y Los Lagos</span><span style=\"font-size: 15px;color: black\">, </span><span style=\"font-size: 15px;color: black\">se reportan los siguientes antecedentes y novedades:</span></p><div><table><tbody><tr><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">SITUACIÓN   METEOROLÓGICA</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Atacama</span></strong></p></td><td><p><span style=\"color:black\">Cielo nublado.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Coquimbo</span></strong></p></td><td><p><span style=\"color:black\">Cielo nublado con lloviznas   intermitentes.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Valparaíso</span></strong></p></td><td><p><span style=\"color:black\">Cielo cubierto y   precipitaciones.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Metropolitana</span></strong></p></td><td><p><span style=\"color:black\">Cielo cubierto y   precipitaciones débiles.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">O’Higgins</span></strong></p></td><td><p><span style=\"color:black\">Cielo cubierto con   precipitaciones y viento.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Maule</span></strong></p></td><td><p><span style=\"color:black\">Cielo cubierto y   precipitaciones.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Ñuble</span></strong></p></td><td><p><span style=\"color:black\">Cielo cubierto.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Biobío</span></strong></p></td><td><p><span style=\"color:black\">Nublado y precipitaciones.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">La Araucanía</span></strong></p></td><td><p><span style=\"color:black\">Nublado.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Los Ríos</span></strong></p></td><td><p><span style=\"color:black\">Cielo cubierto y   precipitaciones.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Los Lagos</span></strong></p></td><td><p><span style=\"color:black\">Cielo cubierto y   precipitaciones.</span></p></td></tr></tbody></table></div><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Fuente: Direcciones Regionales del SENAPRED</span><span style=\"font-size:12px;color:black\">– 16:00 horas (31/07/2025).</span></p><div><table><tbody><tr><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">SITUACIONES DE EMERGENCIA RELEVANTES POR REGIÓN</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Atacama</span></strong></p></td><td rowspan=\"6\"><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:center\"><span style=\"color:black\">Sin novedades</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Coquimbo</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Valparaíso</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Metropolitana</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">O’Higgins</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Maule</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Ñuble</span></strong></p></td><td><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Quillón: </span></strong><span style=\"color:black\">2 viviendas con daños en evaluación, por riesgo de derrumbe al costado   del estero Coyanco, sus ocupantes se encuentran en casa de vecinos.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Pinto:</span></strong><span style=\"color:black\"> Corte preventivo en el km 69 ruta N-55 sector Las Trancas, solo acceso   para residentes.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Coelemu:</span></strong><span style=\"color:black\"> 1 vivienda con daño en evaluación, sus ocupantes pernoctarán en casa   de familiares. Además, la ruta N-14-O km 2.5 sector Perales se reporta un   deslizamiento de tierra, solo se habilita el tránsito de vehículos 4x4.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Ránquil:</span></strong><span style=\"color:black\"> Se reporta el desborde del estero Pirigüín en el sector Puente   Amarillo, afectando a camino vecinal.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Ninhue: </span></strong><span style=\"color:black\">1 vivienda con daño en evaluación sector Hualte por desborde de estero<strong>.   </strong></span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Biobío</span></strong></p></td><td><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Santa Bárbara: </span></strong><span style=\"color:black\">Se registró derrumbe a la altura del kilómetro 37.4   de la Ruta Q-61, la ruta se encuentra cerrada.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Santa Juana: </span></strong><span style=\"color:black\">se reporta de deslizamiento de tierra en la ruta   O-886 km 2,87 sector de Curamavida – Balseadero San Rosendo.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Concepción: </span></strong><span style=\"color:black\">Se registran 5 viviendas con daño menor.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Florida: </span></strong><span style=\"color:black\">se reporta desborde del estero Cangrejillo afectando la ruta O-566   entre los cruces N-48-O, sector Chacras Curapalihue y cruce O-568 sector   Quebrada de Ulloa.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Cabrero: </span></strong><span style=\"color:black\">Corte preventivo del tránsito en el Sector Maquehua, posibles daños   estructurales en el puente que conecta las comunas de Cabrero y Yumbel.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Yumbel: </span></strong><span style=\"color:black\">Se reporta desborde del estero Quinquehua afectando a la ruta SRQ-628   km 4,8 sector Perigallo.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Alto Biobío:</span></strong><span style=\"color:black\"> Se registró un deslizamiento de tierra en la Cuesta   La Zeta.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Los Ángeles: </span></strong><span style=\"color:black\">se reportan 90 viviendas con daño menor.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Negrete: </span></strong><span style=\"color:black\">2.000 viviendas se encuentran con daños en evaluación por rebalse de   fosas sépticas.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt\"><strong><span style=\"color:black\">Comuna de Mulchén: </span></strong><span style=\"color:black\">se reportan 30 viviendas con daño menor.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">La Araucanía</span></strong></p></td><td><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Sin novedades</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Los Ríos</span></strong></p></td><td><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Los Lagos:</span></strong><span style=\"color:black\"> 1 vivienda con daño menor producto de las   precipitaciones en el sector de Quilmes. Por otro lado, 1 vivienda afectada   con daño en evaluación por aguas lluvias en calle Humberto Matamala, sector   de Antilhue.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Corral:</span></strong><span style=\"color:black\"> 12 personas aisladas (4 viviendas), producto a una remoción en masa en   el sector San Juan. </span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Panguipulli: </span></strong><span style=\"color:black\">Una remoción en masa en ruta T-29 y deslizamiento de   material en ruta T-201, sector Mirador Ñisoleufu.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Paillaco:</span></strong><span style=\"color:black\"> Respecto de las 5 personas que permanecían aisladas en el sector Tres   Puentes, debido al desborde del río Collileufu, se indica que ya no presentan   problemas de conectividad debido a la disminución del caudal del río.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Los Lagos</span></strong></p></td><td><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Purranque: </span></strong><span style=\"color:black\">Se registran anegamiento en sectores Ponce y Hueyusca   junto con el estero Potrerillos las Yeguas sector Crucero. Se encuentran 4   personas en albergue sede Cruceros.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Fresia:</span></strong><span style=\"color:black\"> 195 personas se encuentran aisladas producto del desborde del río   Llico. </span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Cochamó:</span></strong><span style=\"color:black\"> Se registra el desborde del río Frío por crecida, lo que generó daños   en un puente, dejando a 69 personas aisladas.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Los Muermos:</span></strong><span style=\"color:black\"> Crecida del río Llico afectando la ruta V-440.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de San Juan de La Costa:</span></strong><span style=\"color:black\"> Por crecida del río Liucura, </span><span style=\"color:black\">en los sectores Liucura y   Quilloimo se informa que aproximadamente 130 personas permanecen aisladas. En   el sector de Loma de la Piedra Ruta U-440 kilómetro 9, camino interior se   registra el aumento de caudal del estero Huacamapu, lo que provocó el corte de   un camino interior, dejando aislados a dos familias (5 adultos en total).</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Río Negro:</span></strong><span style=\"color:black\"> Se mantienen situación del Puente El Bolsón 30   personas aisladas.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Ancud:</span></strong><span style=\"color:black\"> se reporta deslizamiento de tierra y caída de arboles en una pista de   la ruta 5 Sur km 1.118.</span></p><p style=\"margin-right:1.95pt;margin-left:6.65pt;text-align:justify\"><strong><span style=\"color:black\">Comuna de Quellón: </span></strong><span style=\"color:black\">Se registra un socavón en la ruta W-911.</span></p></td></tr></tbody></table></div><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Fuente: Direcciones Regionales del SENAPRED</span><span style=\"font-size:12px;color:black\">– 15:00 horas (31/07/2025).</span></p><p style=\"text-align:justify\"><strong><span style=\"font-size:15px;color:black\">INFORMACIÓN SECTORIAL</span></strong></p><p style=\"margin-right:0cm;margin-left:0cm;text-align:justify\"><span style=\"font-size:15px;color:black\">Según los antecedentes proporcionados por la <strong>Superintendencia de Electricidad y Combustibles (SEC)</strong>, a la hora del presente informe se reporta lo siguiente:</span></p><div><table><tbody><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">REGIÓN</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">NÚMERO TOTAL DE CLIENTES   SIN SUMINISTRO ELÉCTRICO</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Atacama</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">11</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Coquimbo</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">982</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Valparaíso</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">2.438</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Metropolitana</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">10.722</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">O’Higgins</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">5.152</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Maule</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1.775</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Ñuble</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">397</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Biobío</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">2.284</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">La Araucanía</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1.679</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Los Ríos</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">315</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Los Lagos</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color:black\">1.530</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Total</span></strong></p></td><td><p style=\"text-align:center\"><strong><span style=\"color:black\">27.285</span></strong></p></td></tr></tbody></table></div><p style=\"text-align:center\"><span style=\"font-size:12px;color:black\">Cab