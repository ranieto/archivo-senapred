	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región de Coquimbo, Región de la Araucanía, Región de Valparaíso, Región del Libertador Gral. Bernardo O'Higgins, Región del Maule, Región del Biobío, Región de los Lagos, Región Metropolitana de Santiago, Región de los Ríos, Región de Ñuble\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"font-size: 15px\">De acuerdo con la información proporcionada por las Direcciones Regionales del SENAPRED, en el contexto del sistema frontal que se desarrolla entre las regiones de Coquimbo y Los Lagos</span><span style=\"font-size: 15px\">, </span><span style=\"font-size: 15px\">se reportan los siguientes antecedentes y novedades:</span></p><div><table><tbody><tr><td colspan=\"2\"><p style=\"text-align:center\"><strong>SITUACIÓN METEOROLÓGICA</strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong>Coquimbo</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Valparaíso</span></strong></p></td><td><p><span style=\"color:black\">Despejado.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Metropolitana</span></strong></p></td><td><p><span style=\"color:black\">Despejado.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">O’Higgins</span></strong></p></td><td><p><span style=\"color:black\">Despejado.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong>Maule</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>Ñuble</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>Biobío</strong></p></td><td><p><span style=\"color:black\">Nubosidad parcial.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong>La Araucanía</strong></p></td><td><p style=\"margin-right:0cm;margin-left:35.4pt\"><span style=\"color:black\">Nubosidad parcial.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Los Ríos</span></strong></p></td><td><p><span style=\"color:black\">Cielo cubierto con precipitaciones.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color:black\">Los Lagos</span></strong></p></td><td><p><spa