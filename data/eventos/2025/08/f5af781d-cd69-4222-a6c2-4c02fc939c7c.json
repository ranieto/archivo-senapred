	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región de Coquimbo, Región de la Araucanía, Región de Valparaíso, Región del Libertador Gral. Bernardo O'Higgins, Región del Maule, Región del Biobío, Región de los Lagos, Región Metropolitana de Santiago, Región de los Ríos, Región de Ñuble\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"font-size: 15px\">De acuerdo con la información proporcionada por las Direcciones Regionales del SENAPRED, en el contexto del sistema frontal que se desarrolla entre las regiones de Coquimbo y Los Lagos</span><span style=\"font-size: 15px\">, </span><span style=\"font-size: 15px\">se reportan los siguientes antecedentes y novedades:</span></p><div><table><tbody><tr><td colspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"color:black\">SITUACIÓN   METEOROLÓGICA</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong>Coquimbo</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>Valparaíso</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>Metropolitana</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>O’Higgins</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>Maule</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>Ñuble</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>Biobío</strong></p></td><td><p>Despejado.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>La Araucanía</strong></p></td><td><p>Cielo cubierto.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>Los Ríos</strong></p></td><td><p>Cielo cubierto con precipitaciones.</p></td></tr><tr><td><p style=\"text-align:center\"><strong>Los Lagos</strong></p></td><td><p>Cielo cubierto.</p></td></tr></tbody></table></div><p style=\"text-align:center\"><span style=\"font-size:12px\">Fuente: Direcciones Regionales del SENAPRED</span><span style=\"font-size:12px\">– 12:30 horas (23/08/2025).</span></p><div><table><tbody><tr><td rowspan=\"2\"><p style=\"text-align:center\"><strong><span style=\"font-size:12px;color:black\">REGIÓN</span></strong></p></td><td colspan=\"3\"><p st