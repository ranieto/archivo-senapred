	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región de la Araucanía, Región del Libertador Gral. Bernardo O'Higgins, Región del Maule, Región del Biobío, Región de los Lagos, Región de Aysén del Gral. Carlos Ibañez del Campo, Región de los Ríos, Región de Ñuble\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p><span style=\"color: rgb(0, 0, 0)\">De acuerdo con la información proporcionada por las Direcciones Regionales del SENAPRED, en el contexto del sistema frontal que se desarrolla entre las regiones de O’Higgins y Aysén,se reportan los siguientes antecedentes y novedades:</span></p><div><span style=\"color: rgb(0, 0, 0)\"><br></span></div><div><table><tbody><tr><td colspan=\"2\"><p style=\"text-align: center\"><strong>SITUACIÓN METEOROLÓGICA</strong></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">O’Higgins</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Despejado.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Maule</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Despejado.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Ñuble</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Costa despejado e interior nublado.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Biobío</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Precipitaciones débiles en Provincia del Biobío, resto de la región nubosidad parcial.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">La Araucanía</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Cubierto con precipitación, viento y tormentas eléctricas.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Los Ríos</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Nublado y chubascos débiles.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Los Lagos</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Nublado.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Aysén</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Cubierto y Lluvia.</span></p></td></tr></tbody></table></div><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Fuente: Direcciones Regionales del SENAPRED</span><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">– 12:20 horas (17/03/2026).</span></p><div><br></div><div><table><tbody><tr><td rowspan=\"2\"><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong><span style=\"font-size: 12px\">REGIÓN</span></strong></span></p></td><td colspan=\"3\"><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong><span style=\"font-size: 12px\">DAÑO A VIVIENDAS</span></strong></span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong><span style=\"font-size: 12px\">Daño mayor</span></strong></span></p></td><td><p style=\"text-align: center\"><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Daño menor</span></strong></p></td><td><p style=\"text-align: center\"><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Daños en evaluación</span></strong></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">O’Higgins</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">10</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Maule</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Ñuble</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Biobío</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">15</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">21</span></p></td></tr><tr><td><p><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">La Araucanía</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">5</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">16</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Los Ríos</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">1</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">8</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Los Lagos</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Aysén</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">0</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong><span style=\"font-size: 12px\">Total</span></strong></span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">5</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">42</span></p></td><td><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">29</span></p></td></tr></tbody></table></div><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Fuente: Direcciones Regionales del SENAPRED</span><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">– 12:20 horas (17/03/2026).</span></p><div><br></div><div><table><tbody><tr><td colspan=\"2\"><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>SITUACIONES DE EMERGENCIA RELEVANTES POR REGIÓN</strong></span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">O’Higgins</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Malloa:</strong>1 vivienda con daño menor producto de una remoción en masa en la localidad de Cantarrana.</span></p><p><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de San Fernando:</strong>9 viviendas con daño menor, además de anegamientos en diversos sectores y suspensión preventiva de tránsito vehicular Ruta I-45, desde kilómetro 2938 hasta Termas del Flaco.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Maule</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Romeral:</strong>Transito suspendido en sectores Paso Ancho y Pumaiten, por aumento de caudal del Estero Gauquillo.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Linares:</strong>Se registra socavón en sector Vega el Molino existiendo rutas alternativas.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Se mantiene el cierre de los Pasos Fronterizos Pehuenche y San Pedro de Vergara.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Ñuble</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Bulnes:</strong>Los daños reportados en viviendas de la Villa Santa Fé fueron menores y serán cubiertas por la empresa que entrego las viviendas utilizando la garantía de estas mismas.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Biobío</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Alto Biobío</strong>: 1 vivienda con daños en evaluación por anegamiento.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Talcahuano</strong>: Deslizamiento de tierra en Calle Las Araucarias con La Serena, Cerro Zarol, desvío de tránsito por rutas alternativas.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Antuco:</strong>se mantiene restricción de tránsito en la Ruta Q- 45, sector Los Barros, altura del km. 110, debido a la erosión del terreno provocada por el cauce del estero El Volcán.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Los Ángeles:</strong>1 vivienda con daño menor y 10 con daños en evaluación por anegamiento.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Concepción</strong>: 7 viviendas con daño menor por anegamiento.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Tomé</strong>: 7 viviendas con daño menor y 10 con daños en evaluación por anegamiento.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Hualpén:</strong>Se reporta que existen 2 establecimientos educacionales con filtraciones.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Lota:</strong>Se reporta que existe 1 establecimiento educacional con filtraciones.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">La Araucanía</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Temuco:</strong>Se mantiene el desborde de canal Pillanlelbun, en el sector de Las Mariposas. 20 personas damnificadas y 5 viviendas con daño mayor en sectores de Santa Rosa, Pedro de Valdivia y Amanecer. Damnificados fueron llevados a casas de familiares.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Curarrehue</strong>: Deslizamiento de tierra hacia camino Maite Remeco, quedando transitable sólo para vehículos 4x4; camino alternativo aledaño a puente Malalco inhabilitado por crecida de cauce estero Malalco.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Toltén:</strong>16 viviendas con daño menor, además se mantiene corte de Ruta S-270-T acceso a localidad de Queule por remoción en masa, se habilita ruta alternativa por ByPass Queule. &nbsp;</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Las balsas de conectividad en los sectores de Nehuentúe, comuna de Saavedra y Moncul, comuna Carahue, se mantienen fuera de servicio por condiciones meteorológicas.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Los Ríos</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Valdivia:</strong>8 viviendas con daño en evaluación.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Los Lagos:</strong>Ruta T-516 alterada por aumento de caudal con afectación a la ruta.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Futrono:</strong>1 vivienda con daño menor en el sector de Llifén.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Los Lagos</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Cochamó:</strong>Se mantiene tránsito con precaución en la RutaV-69 (Ensenada-Puelo-Puelche), debido a remoción en masa.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Purranque:</strong>Se realiza el cierre de camino no enrolado que corresponde a una vía de acceso a comunidades indígenas por colapso de alcantarilla.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Tránsito interrumpido para todo tipo de vehículos en el Puente El Molino ruta U-900, existiendo caminos alternativos, por aumento de caudal del río.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Comuna de Puerto Varas:</strong>Se mantiene 1 pista habilitada por remoción en masa en la Ruta CH-225, sector Los Patos altura del km 51.4, trabaja vialidad.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">CONAF mantiene el cierre de los sectores de Saltos de Petrohué y senderos del sector Petrohué del Parque Nacional Vicente Pérez Rosales.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Aysén</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Sin novedades.</span></p></td></tr></tbody></table></div><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Fuente: Direcciones Regionales del SENAPRED</span><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">– 12:20 horas (17/03/2026).</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>2.INFORMACIÓN SECTORIAL</strong></span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Según los antecedentes proporcionados por la<strong>Superintendencia de Electricidad y Combustibles (SEC)</strong>, a la hora del presente informe se reporta lo siguiente:</span></p><div><br></div><div><table><tbody><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>REGIÓN</strong></span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>NÚMERO TOTAL DE CLIENTES SIN SUMINISTRO ELÉCTRICO</strong></span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">O’Higgins</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">2.362</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Maule</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">1.708</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Ñuble</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">491</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Biobío</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">3.900</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">La Araucanía</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">4.260</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Los Ríos</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">1.785</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Los Lagos</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">1.489</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Aysén</span></strong></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">21</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Total</strong></span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>16.016</strong></span></p></td></tr></tbody></table></div><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Cabe mencionar, que estos cortes de energía eléctrica no necesariamente tienen como origen el Sistema frontal.</span></p><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Fuente: SEC – 12:20 horas (17/03/2026).</span></p><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Por su parte, la<strong>Subsecretaría de Telecomunicaciones (SUBTEL)</strong>indica que actualmente se mantiene activo el Roaming Automático de Emergencia en las regiones de Ñuble y Biobío, reforzando los servicios para las comunas de Ñiquén, Quirihue, Treguaco y Cobquecura en la Región de Ñuble y comunas de Tirúa, Florida, Hualqui, Contulmo y Santa Juana en la Región de Biobío.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Asimismo, el<strong>Ministerio de Educación (MINEDUC)</strong>indica que en la Región de Biobío, 3 establecimientos fueron destinados como albergues, no obstante no hay personas albergadas al momento.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>3.ALERTAMIENTO TÉCNICO VIGENTE</strong></span></p><div><table><tbody><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong><span style=\"font-size: 12px\">ALERTAMIENTO</span></strong></span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>PRONÓSTICOS</strong></span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong><span style=\"font-size: 12px\">INICIO</span></strong></span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong><span style=\"font-size: 12px\">FIN</span></strong></span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Aviso A117-1</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Viento normal a moderado en zonas entre las regiones Metropolitana y Biobío.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">14-03</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">17-03</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Aviso A130</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Precipitaciones normales a moderadas en zonas de la Región de Los Lagos.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">18-03</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">18-03</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Aviso A131</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Viento normal a moderado en zonas de las regiones de Los Lagos y Aysén.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">18-03</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">18-03</span></p></td></tr></tbody></table></div><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Fuente: Dirección Meteorológica de Chile (DMC).</span></p><div><br></div><div><table><tbody><tr><td colspan=\"2\"><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>MINUTA TÉCNICA POR PELIGRO DE REMOCIONES EN MASA</strong></span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Región</strong></span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Categoría</strong></span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">O’Higgins</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\"><strong>Moderada</strong>encordillera de la costa y valle longitudinal.</span></p><p><span style=\"color: rgb(0, 0, 0)\"><strong>Baja</strong>en litoral, precordillera y cordillera.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Maule</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\"><strong>Alta</strong>en precordillera y cordillera.</span></p><p><span style=\"color: rgb(0, 0, 0)\"><strong>Moderada</strong>en valle longitudinal.</span></p><p><span style=\"color: rgb(0, 0, 0)\"><strong>Baja</strong>en litoral y cordillera de la costa.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Ñuble</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\"><strong>Moderada</strong>en precordillera y cordillera.</span></p><p><span style=\"color: rgb(0, 0, 0)\"><strong>Baja</strong>en valle longitudinal, litoral y cordillera de la costa.&nbsp;</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Biobío</span></strong></p></td><td><p><span style=\"color: rgb(0, 0, 0)\"><strong>Moderada</strong>en precordillera y cordillera.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Baja</strong>en valle longitudinal litoral y cordillera de la costa.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">La Araucanía</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Moderada</strong>en litoral, cordillera de la costa, valle longitudinal, precordillera y cordillera.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Los Ríos</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Moderada</strong>en litoral, cordillera de la costa, valle longitudinal, precordillera y cordillera.</span></p></td></tr><tr><td><p style=\"text-align: center\"><strong><span style=\"color: rgb(0, 0, 0)\">Los Lagos</span></strong></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Moderada</strong>en litoral, cordillera de la costa, valle longitudinal, precordillera, Chiloé, litoral interior y patagonia subandina.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>Baja</strong>en cordillera y cordillera austral.</span></p></td></tr></tbody></table></div><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Fuente: SERNAGEOMIN – 16/03/2026.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong>4.ALERTAS RELEVANTES VIGENTES</strong></span></p><div><br></div><div><table><tbody><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Tipo de alerta</strong></span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Cobertura</strong></span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Causalidad</strong></span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Vigencia</strong></span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>AMARILLA</strong></span></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Comuna de Corral, Región de Los Ríos.</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Remoción en masa.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">06-06-2025</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>TEMPRANA PREVENTIVA</strong></span></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Región del Maule.</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Evento meteorológico.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">13-03-2026</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>TEMPRANA PREVENTIVA</strong></span></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Región del Biobío.</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Evento meteorológico.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">17-03-2026</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>TEMPRANA PREVENTIVA</strong></span></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Región de Los Lagos.</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Evento meteorológico.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">11-03-2026</span></p></td></tr><tr><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\"><strong>TEMPRANA PREVENTIVA</strong></span></p></td><td><p><span style=\"color: rgb(0, 0, 0)\">Provincia de Aysén, Región de Aysén.</span></p></td><td><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Evento meteorológico.</span></p></td><td><p style=\"text-align: center\"><span style=\"color: rgb(0, 0, 0)\">13-03-2026</span></p></td></tr></tbody></table></div><p style=\"text-align: center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Fuente: SENAPRED – 13:20 horas (17/03/2026).</span></p><p style=\"margin-right: 0cm;margin-left: 18pt;text-align: justify\"><span style=\"color: rgb(0, 0, 0)\"><strong><span style=\"font-size: 15px\">5.CURSOS DE ACCIÓN</span></strong></span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Las Direcciones Regionales del SENAPRED mantienen el monitoreo continuo en cada una de las comunas en coordinación con el Sistema Nacional de Prevención y Respuesta ante Desastres (SINAPRED), en base a sus procedimientos de coordinación a nivel regional.</span></p><p style=\"text-align: justify\"><span style=\"color: rgb(0, 0, 0)\">Al momento, se ha realizado diversas Mesas Técnicas y COGRID a nivel Regional, Provincial y Comunal. Asimismo, se han realizado 2 Mesas Técnicas a nivel Nacional.</span></p>",
