	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región del Libertador Gral. Bernardo O'Higgins\",\"nombreVariable\":\"Sismo\",\"nombreImg\":\"sismo.png\"}",
	"contenido": "<p><span style=\"font-size: 14px\">​</span><span style=\"font-size: 14px\">Un sismo de menor intensidad se percibió a las 08:55 horas en la Región de O'Higgins. Las intensidades en escala de Mercalli son:</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px\"><br></span></p><table><tbody><tr><td colspan=\"2\"><p><strong><span style=\"font-size: 14px\">Región: O'Higgins</span></strong></p></td></tr><tr><td><p><span style=\"font-size: 14px\">Pichilemu:</span></p></td><td><p><span style=\"font-size: 14px\">III</span></p></td></tr></tbody></table><p style=\"text-align: justify\"><span style=\"font-size: 14px\"><br><br></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px\">El Sistema Nacional de Prevención y Respuesta ante Desastres continúa evaluando afectación a personas y daños a infraestructura y servicios básicos, cuyo resultado se reportará a través de los informes de incidente o emergencia elaborados por SENAPRED.</span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px\"><br></span></p><p style=\"text-align: justify\"><span style=\"font-size: 14px\">El Centro Sismológico Nacional indica que la magnitud del sismo fue 4.4 y se localizó a 35 Kms al Oeste de Navidad.</span></p>",
	"variableInformateEventosId": "0083430a-1a78-4574-9b23-79768d027d67"
