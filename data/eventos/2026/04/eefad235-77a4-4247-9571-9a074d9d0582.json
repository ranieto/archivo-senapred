	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región del Maule\",\"nombreVariable\":\"Incendio Estructural\",\"nombreImg\":\"incendioestructural.png\"}",
	"contenido": "<p style=\"margin-right:2.55pt;margin-left:0cm;text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De acuerdo con la información proporcionada por la Dirección Regional de SENAPRED Maule, se reporta un incendio estructural que afecta a 11 locales comerciales, ubicados en el sector de la intersección de calles Las Delicias Norte con Igualdad, comuna de Parral.</span></p><p style=\"margin-right: 2.55pt;margin-left: 0cm;text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"margin-right:2.55pt;margin-left:0cm;text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De manera preliminar, se reportan 3 personas lesionadas, correspondientes a bomberos, mientras se evalúa el daño a los locales comerciales.</span></p><p style=\"margin-right: 2.55pt;margin-left: 0cm;text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"margin-right:2.55pt;margin-left:0cm;text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Trabajan en el lugar Bomberos de Parral, Carabineros, Ambulancia SAR Parral y personal municipal.</span></p>",
	"variableInformateEventosId": "7322a131-ba37-4e12-892f-d7008aec4648"
