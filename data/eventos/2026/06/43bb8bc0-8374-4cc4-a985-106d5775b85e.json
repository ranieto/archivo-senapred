	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región Metropolitana de Santiago\",\"nombreVariable\":\"Otros\",\"nombreImg\":\"otros.png\"}",
	"contenido": "<p style=\"text-align:justify\"><span style=\"font-size:15px\"><span style=\"color: rgb(0, 0, 0)\">De acuerdo con la información proporcionada por la Dirección Metropolitana del SENAPRED, en el contexto las precipitaciones y viento registrados en la región, se reportan los siguientes antecedentes y novedades:</span></span></p><p style=\"text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Durante la mañana se registraron precipitaciones débiles en los sectores norte y sur de la región, acompañados de viento entre 30 y 40 km/h. No obstante, de acuerdo con lo informado por <strong>Dirección Meteorológica de Chile (DMC)</strong> el fenómeno obedece sólo al tipo de nubes presentes en la zona.</span></p><p style=\"text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><div><table><tbody><tr><td colspan=\"2\"><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><span style=\"color: rgb(0, 0, 0)\"><strong>SITUACIONES DE EMERGENCIA RELEVANTES</strong></span></span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">San Bernardo </span></strong></p></td><td rowspan=\"6\"><p style=\"margin-right:9.05pt;margin-left:3.5pt;text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Caída de   árboles en diferentes puntos de las comunas provocadas por el viento.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">El Bosque</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Peñalolén </span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">La Pintana</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Paine</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Buin</span></strong></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Pirque</span></strong></p></td><td><p style=\"margin-right:9.05pt;margin-left:3.5pt;text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Se   registra una vivienda con daño menor en su segundo piso producto de   desprendimiento de techo. Caída de árboles en diferentes puntos de la comuna   provocadas por el viento.</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Puente Alto</span></strong></p></td><td><p style=\"margin-right:9.05pt;margin-left:3.5pt;text-align:justify\"><span style=\"color: rgb(0, 0, 0)\">Se   registran 11 viviendas con daños en evaluación por desprendimientos de   techumbres. Caída de árboles en diferentes puntos de la comuna provocadas por   el viento.</span></p></td></tr></tbody></table></div><p style=\"text-align:center\"><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">Fuente: Dirección Metropolitana del SENAPRED</span><span style=\"font-size: 12px;color: rgb(0, 0, 0)\">– 15:30 horas (12/06/2026).</span></p><p style=\"text-align: justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></strong></p><p style=\"text-align:justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">INFORMACIÓN SECTORIAL</span></strong></p><p style=\"text-align: justify\"><strong><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></strong></p><p style=\"margin-right:0cm;margin-left:0cm;text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Según los antecedentes proporcionados por la <strong>Superintendencia de Electricidad y Combustibles (SEC)</strong>, a la hora del presente informe se reporta lo siguiente:</span></p><p style=\"margin-right: 0cm;margin-left: 0cm;text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></sp