td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Macul </span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">196</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Melipilla</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">374</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Peñalolén</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">246</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">La   Florida </span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">751</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Curacaví</span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">212</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Talagante   </span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">191</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">Pudahuel   </span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">44</span></p></td></tr><tr><td><p style=\"text-align:center\"><strong><span style=\"color: rgb(0, 0, 0)\">La   Reina </span></strong></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\">44</span></p></td></tr><tr><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>Total</strong></span></p></td><td><p style=\"text-align:center\"><span style=\"color: rgb(0, 0, 0)\"><strong>16.051</strong></span></p></td></tr></tbody></table></div><p style=\"text-align:center\"><span styl