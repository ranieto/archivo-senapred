	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región Metropolitana de Santiago\",\"nombreVariable\":\"Incendio Estructural\",\"nombreImg\":\"incendioestructural.png\"}",
	"contenido": "<p style=\"margin-right:2.55pt;margin-left:0cm;text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">De acuerdo con la información proporcionada por la Dirección Metropolitana de SENAPRED, se reporta un incendio estructural que afecta un número en evaluación de viviendas ubicadas en las cercanías de las calles Álvaro Sánchez Pinzón y Nuño Da Silva, población La Legua de Emergencia.</span></p><p style=\"margin-right: 2.55pt;margin-left: 0cm;text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"margin-right:2.55pt;margin-left:0cm;text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Al momento, no se han reportado personas lesionadas ni otras emergencias derivadas del evento.</span></p><p style=\"margin-right: 2.55pt;margin-left: 0cm;text-align: justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\"><br></span></p><p style=\"margin-right:2.55pt;margin-left:0cm;text-align:justify\"><span style=\"font-size: 15px;color: rgb(0, 0, 0)\">Trabajan en el lugar Bomberos Metropolitano Sur y La Granja- San Ramón-La Pintana, Carabineros y personal municipal.</span></p>",
