	"metaData": "{\"provincias\":\"\",\"codigoAlertaEvento\":\"az\",\"comunas\":\"\",\"regiones\":\"Región de la Araucanía\",\"nombreVariable\":\"Incendio Estructural\",\"nombreImg\":\"incendioestructural.png\"}",
	"contenido": "<p style=\"margin-right:2.55pt;margin-left:0cm;text-align:justify\"><span style=\"font-size:15px\">De acuerdo con la información proporcionada por la Dirección Regional de La Araucanía del SENAPRED, se reporta un <strong>incendio estructural</strong> que afecta a <strong>un hogar de ancianos</strong> ubicado en el kilómetro 21 de la Ruta S-70, sector Villa Comuy de la comuna de Pitrufuquén.</span></p><p style=\"margin-right: 2.55pt;margin-left: 0cm;text-align: justify\"><span style=\"font-size:15px\"><br></span></p><p style=\"margin-right:2.55pt;margin-left:0cm;text-align:justify\"><span style=\"font-size:15px\">Al momento se reportan <strong>13 personas evacuadas</strong>.</span></p><p style=\"margin-right: 2.55pt;margin-left: 0cm;text-align: justify\"><span style=\"font-size:15px\"><br></span></p><p style=\"margin-right:2.55pt;margin-left:0cm;text-align:justify\"><span style=\"font-size:15px\">Trabajan en el lugar Bomberos, Carabineros y personal municipal. Del mismo modo, se dispuso como albergue el Liceo La Frontera para las personas afectadas.</span></p>",
	"variableInformateEventosId": "7322a131-ba37-4e12-892f-d7008aec4648"
}
